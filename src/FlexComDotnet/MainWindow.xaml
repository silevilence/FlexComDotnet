<Window x:Class="FlexComDotnet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexComDotnet"
        xmlns:serialViews="clr-namespace:FlexComDotnet.Features.Serial.Views"
        xmlns:layoutControls="clr-namespace:FlexComDotnet.Features.Layout.Controls"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        mc:Ignorable="d"
        Title="FlexCom - 串口调试助手" 
        Icon="app_icon.ico"
        Height="700" 
        Width="1300"
        MinHeight="500"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Closing="Window_Closing">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Activity Bar (侧边导航栏) -->
        <layoutControls:ActivityBar x:Name="ActivityBar" 
                                     Grid.Column="0"
                                     Grid.Row="0"
                                     ZoneToggled="ActivityBar_ZoneToggled"/>
        
        <!-- 多区域布局 -->
        <layoutControls:MultiZoneLayout x:Name="MultiZoneLayout" 
                                         Grid.Column="1"
                                         Grid.Row="0"
                                         ZoneSizeChanged="MultiZoneLayout_ZoneSizeChanged">
            <layoutControls:MultiZoneLayout.CenterContentElement>
                <!-- 中央：收发区域 -->
                <serialViews:SerialCommunicationView/>
            </layoutControls:MultiZoneLayout.CenterContentElement>
        </layoutControls:MultiZoneLayout>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource StatusBarBorderBrush}"
                BorderThickness="0,1,0,0"
                Height="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧状态信息（预留） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- 可以在这里添加连接状态等信息 -->
                </StackPanel>

                <!-- 右侧统计信息 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- RX 统计 (下箭头图标) -->
                    <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                          Fill="{DynamicResource InfoBrush}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"/>
                    <TextBlock Text="RX:" 
                               Foreground="{DynamicResource StatusBarForegroundBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="RxBytesText" 
                               Text="0"
                               Foreground="{DynamicResource StatusBarAccentBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               MinWidth="50"
                               TextAlignment="Right"/>
                    <TextBlock Text="B" 
                               Foreground="{DynamicResource StatusBarForegroundBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="2,0,12,0"/>

                    <!-- TX 统计 (上箭头图标) -->
                    <Path Data="M5,4V6H19V4M5,14H9V20H15V14H19L12,7L5,14Z"
                          Fill="{DynamicResource SuccessBrush}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"/>
                    <TextBlock Text="TX:" 
                               Foreground="{DynamicResource StatusBarForegroundBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxBytesText" 
                               Text="0"
                               Foreground="{DynamicResource StatusBarAccentBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               MinWidth="50"
                               TextAlignment="Right"/>
                    <TextBlock Text="B" 
                               Foreground="{DynamicResource StatusBarForegroundBrush}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="2,0,8,0"/>

                    <!-- 重置按钮 (图标) -->
                    <Button x:Name="ResetCountersButton"
                            Click="ResetCounters_Click"
                            ToolTip="重置统计"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- 重置图标 (使用 Path 绘制循环箭头) -->
                        <Path Data="M12,4C14.1,4 16.1,4.8 17.6,6.3L20,4V10H14L16.2,7.8C15.1,6.7 13.6,6 12,6C8.7,6 6,8.7 6,12C6,15.3 8.7,18 12,18C14.8,18 17.1,16.2 17.8,13.5H19.9C19.1,17.4 15.9,20 12,20C7.6,20 4,16.4 4,12C4,7.6 7.6,4 12,4Z"
                              Fill="{DynamicResource StatusBarForegroundBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
