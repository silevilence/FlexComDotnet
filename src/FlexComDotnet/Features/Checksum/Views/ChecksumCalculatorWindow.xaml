<Window x:Class="FlexComDotnet.Features.Checksum.Views.ChecksumCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        mc:Ignorable="d"
        Title="校验和计算器" 
        Height="600" 
        Width="500"
        MinHeight="500"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="50"/>
        </Style>
        
        <Style x:Key="ResultValueStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="pu:TextBoxHelper.CornerRadius" Value="4"/>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 算法选择区域 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="算法选择" Style="{StaticResource SectionTitleStyle}"/>
                
                <ComboBox Grid.Row="1"
                          ItemsSource="{Binding AvailableAlgorithms}"
                          SelectedItem="{Binding SelectedAlgorithm}"
                          Height="36"
                          Background="{DynamicResource CardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          pu:ComboBoxHelper.CornerRadius="4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <TextBlock Grid.Row="2" 
                           Text="{Binding AlgorithmInfo}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>
        
        <!-- 输入区域 -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="输入数据 (Hex)" Style="{StaticResource SectionTitleStyle}" Margin="0" DockPanel.Dock="Left"/>
                    <Button Content="📥 导入待发送帧"
                            x:Name="ImportButton"
                            Click="ImportButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            HorizontalAlignment="Right"
                            Padding="8,4"/>
                </DockPanel>
                
                <TextBox Grid.Row="1"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource CardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         FontFamily="Consolas, Courier New"
                         FontSize="13"
                         Padding="8"
                         pu:TextBoxHelper.CornerRadius="4"/>
                
                <!-- ASCII 预览 -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Text="ASCII 预览:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding AsciiPreview}" 
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AsciiPreview}"/>
                </StackPanel>
                
                <!-- 操作按钮 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="📋 粘贴" 
                            Command="{Binding PasteFromClipboardCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Margin="0,0,8,0"/>
                    <Button Content="🗑️ 清空" 
                            Command="{Binding ClearInputCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 计算按钮 -->
        <Button Grid.Row="2"
                Content="⚡ 计算"
                Command="{Binding CalculateCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Height="40"
                FontSize="14"
                VerticalAlignment="Top"
                Margin="0,0,0,12"/>
        
        <!-- 结果区域 -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="计算结果" Style="{StaticResource SectionTitleStyle}"/>
                
                <!-- Hex 结果 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Hex:" Style="{StaticResource ResultLabelStyle}"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding ResultHex, Mode=OneWay}" 
                             Style="{StaticResource ResultValueStyle}"/>
                    <Button Grid.Column="2"
                            Content="📋"
                            Command="{Binding CopyResultCommand}"
                            ToolTip="复制结果"
                            Width="32"
                            Height="32"
                            Margin="8,0,0,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
                
                <!-- 十进制结果 -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Dec:" Style="{StaticResource ResultLabelStyle}"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding ResultDecimal, Mode=OneWay}" 
                             Style="{StaticResource ResultValueStyle}"/>
                </Grid>
                
                <!-- 错误信息 -->
                <TextBlock Grid.Row="3" 
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                
                <!-- 附加结果按钮 -->
                <Button Grid.Row="4"
                        Content="📤 附加结果到发送帧"
                        Command="{Binding AppendResultToSendFrameCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>
            </Grid>
        </Border>
        
        <!-- 关闭按钮 -->
        <Button Grid.Row="4"
                Content="关闭"
                Click="CloseButton_Click"
                HorizontalAlignment="Right"
                Style="{StaticResource ActionButtonStyle}"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Width="80"
                Margin="0,0,0,8"/>
    </Grid>
    </ScrollViewer>
</Window>
