<UserControl x:Class="FlexComDotnet.Features.EmojiSupport.Controls.EmojiCompletionPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">
  <Popup x:Name="CompletionPopup"
         StaysOpen="False"
         AllowsTransparency="True"
         PopupAnimation="Fade"
         Placement="Bottom">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="2"
            MaxHeight="240"
            MinWidth="200"
            MaxWidth="320">
      <Border.Effect>
        <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="2"/>
      </Border.Effect>
      <ListBox x:Name="CompletionListBox"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionMode="Single"
               KeyDown="CompletionListBox_KeyDown"
               MouseDoubleClick="CompletionListBox_MouseDoubleClick">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Border" 
                          Background="Transparent" 
                          CornerRadius="4"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <!-- 彩色 Emoji 渲染 -->
              <emoji:TextBlock Text="{Binding Emoji}" 
                               FontSize="16" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
              <!-- 短码 -->
              <TextBlock VerticalAlignment="Center">
                <Run Text=":" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Run Text="{Binding Shortcode, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Run Text=":" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Popup>
</UserControl>
