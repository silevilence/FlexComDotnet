<UserControl x:Class="FlexComDotnet.Features.EmojiSupport.Controls.EmojiTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:emojiBehavior="clr-namespace:FlexComDotnet.Features.EmojiSupport.Behaviors"
             Focusable="True"
             MouseDown="UserControl_MouseDown">
  <Grid>
    <!-- 彩色 Emoji 显示层（始终可见，底层渲染） -->
    <emoji:TextBlock x:Name="DisplayBlock"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     VerticalAlignment="Center"
                     Padding="1,0,0,0"
                     IsHitTestVisible="False"/>

    <!-- 透明 TextBox 编辑层（始终存在，顶层接受输入，文字透明光标可见） -->
    <TextBox x:Name="EditBox"
             Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
             FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Foreground="Transparent"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             VerticalContentAlignment="Center"
             CaretBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
             emojiBehavior:EmojiCompletionBehavior.IsEnabled="True"/>
  </Grid>
</UserControl>
