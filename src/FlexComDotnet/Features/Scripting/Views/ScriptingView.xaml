<UserControl x:Class="FlexComDotnet.Features.Scripting.Views.ScriptingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexComDotnet.Features.Scripting.Views"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="{DynamicResource SurfaceBrush}">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        <converters:LogLevelToLabelConverter x:Key="LogLevelToLabelConverter"/>

        <!-- 工具栏按钮样式 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 操作按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 运行按钮样式 -->
        <Style x:Key="RunButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 停止按钮样式 -->
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 打开编辑器按钮样式 -->
        <Style x:Key="OpenEditorButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- 脚本列表项样式 -->
        <Style x:Key="ScriptListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 标题 + 新建脚本 -->
            <RowDefinition Height="Auto"/>
            <!-- 脚本列表 -->
            <RowDefinition Height="*"/>
            <!-- Hook 配置 -->
            <RowDefinition Height="Auto"/>
            <!-- 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 代码预览 -->
            <RowDefinition Height="Auto"/>
            <!-- 日志预览 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================= 标题 + 新建 ========================= -->
        <StackPanel Grid.Row="0">
            <!-- 标题 -->
            <Border Padding="10,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="📜 脚本管理" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- 新建脚本 -->
            <Border Padding="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewScriptName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Padding="6,4"
                             Background="{DynamicResource CardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             pu:TextBoxHelper.Watermark="脚本名称..."
                             pu:TextBoxHelper.CornerRadius="4">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateNewScriptCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="＋" FontSize="14" FontWeight="Bold"
                            Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding CreateNewScriptCommand}"
                            ToolTip="新建脚本" Margin="4,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ========================= 脚本列表 ========================= -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Scripts}"
                 SelectedItem="{Binding SelectedScript}"
                 ItemContainerStyle="{StaticResource ScriptListItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ========================= Hook 配置 ========================= -->
        <Border Grid.Row="2" Padding="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsHookSupported, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="🔗 Hook 配置" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>

                <!-- 接收预处理 Hook -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" 
                              IsChecked="{Binding RxHookEnabled}"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Scripts}"
                              SelectedValue="{Binding RxHookScriptId}"
                              SelectedValuePath="Id"
                              FontSize="11" Padding="4,2"
                              Background="{DynamicResource CardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              IsEnabled="{Binding RxHookEnabled}"
                              pu:ComboBoxHelper.CornerRadius="4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="Rx预处理" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               ToolTip="接收数据预处理：修改/解密接收到的数据"/>
                </Grid>

                <!-- 发送后处理 Hook -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding TxHookEnabled}"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Scripts}"
                              SelectedValue="{Binding TxHookScriptId}"
                              SelectedValuePath="Id"
                              FontSize="11" Padding="4,2"
                              Background="{DynamicResource CardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              IsEnabled="{Binding TxHookEnabled}"
                              pu:ComboBoxHelper.CornerRadius="4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="Tx后处理" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               ToolTip="发送数据后处理：加封包/校验发送的数据"/>
                </Grid>

                <!-- 应答 Hook -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding ReplyHookEnabled}"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Scripts}"
                              SelectedValue="{Binding ReplyHookScriptId}"
                              SelectedValuePath="Id"
                              FontSize="11" Padding="4,2"
                              Background="{DynamicResource CardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              IsEnabled="{Binding ReplyHookEnabled}"
                              pu:ComboBoxHelper.CornerRadius="4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="脚本应答" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               ToolTip="脚本应答：使用脚本处理自动回复逻辑"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================= 操作工具栏 ========================= -->
        <Border Grid.Row="3" Padding="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- 状态 -->
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,0,0,6"/>
                
                <!-- 按钮组 -->
                <WrapPanel>
                    <Button Content="▶ 运行" Style="{StaticResource RunButtonStyle}"
                            Command="{Binding RunScriptCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            ToolTip="运行当前脚本"/>
                    <Button Content="■ 停止" Style="{StaticResource StopButtonStyle}"
                            Command="{Binding StopScriptCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="停止脚本"/>
                    <Button Content="📝 编辑器" Style="{StaticResource OpenEditorButtonStyle}"
                            Command="{Binding OpenEditorCommand}"
                            ToolTip="打开脚本编辑器窗口"/>
                    <Button Content="🗑" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding DeleteScriptCommand}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                            ToolTip="删除脚本"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ========================= 代码预览 (只读) ========================= -->
        <Border Grid.Row="4" MaxHeight="150"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="8,4"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="📄 代码预览" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <TextBox Grid.Row="1"
                         Text="{Binding EditorContent, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="11"
                         Background="{DynamicResource CardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="8,4"
                         MaxHeight="120"
                         Cursor="Arrow"/>
            </Grid>
        </Border>

        <!-- ========================= 日志预览 ========================= -->
        <Border Grid.Row="5" MaxHeight="150"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 日志标题栏 -->
                <Border Grid.Row="0" Padding="8,4"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="🗑"
                                Style="{StaticResource ToolButtonStyle}"
                                Command="{Binding ClearLogsCommand}"
                                ToolTip="清空日志" Width="22" Height="22"/>
                        <TextBlock Text="📋 日志" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- 日志列表 -->
                <ListBox Grid.Row="1" x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         Background="{DynamicResource BackgroundBrush}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="10"
                         MaxHeight="120">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,1"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Level, Converter={StaticResource LogLevelToLabelConverter}}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           FontWeight="SemiBold"
                                           MinWidth="28" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Message}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="200"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
