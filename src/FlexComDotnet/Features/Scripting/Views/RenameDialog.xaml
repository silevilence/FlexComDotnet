<Window x:Class="FlexComDotnet.Features.Scripting.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:emojiBehavior="clr-namespace:FlexComDotnet.Features.EmojiSupport.Behaviors"
        xmlns:emojiControls="clr-namespace:FlexComDotnet.Features.EmojiSupport.Controls"
        Title="重命名脚本"
        Height="180"
        Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    
    <StackPanel Margin="16">
        <TextBlock Text="请输入新名称：" FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,8"/>

        <emojiControls:EmojiTextBox x:Name="NameTextBox"
                 FontSize="12" Height="32"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Padding="16,6" Margin="0,0,8,0"
                    Background="{DynamicResource CardBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    pu:ButtonHelper.CornerRadius="4"
                    Click="Cancel_Click"/>
            <Button Content="确定" Padding="16,6"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White"
                    pu:ButtonHelper.CornerRadius="4"
                    Click="OK_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
