<Window x:Class="FlexComDotnet.Features.Scripting.Views.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        Title="删除脚本"
        Height="160"
        Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="⚠" FontSize="24" Foreground="#F0A020" 
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="MessageText" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" Padding="16,6" Margin="0,0,8,0"
                    Background="{DynamicResource CardBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    pu:ButtonHelper.CornerRadius="4"
                    Click="Cancel_Click"/>
            <Button Content="删除" Padding="16,6"
                    Background="#C42B1C"
                    Foreground="White"
                    pu:ButtonHelper.CornerRadius="4"
                    Click="OK_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
