<Window x:Class="FlexComDotnet.Features.Settings.Views.DebugToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:converters="clr-namespace:FlexComDotnet.Converters"
        mc:Ignorable="d"
        Title="调试工具"
        Height="360"
        Width="480"
        MinHeight="300"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">

  <Window.Resources>
    <converters:LogSourceToDisplayNameConverter x:Key="LogSourceToDisplayNameConverter"/>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <TabControl Background="Transparent"
                BorderThickness="0"
                pu:TabControlHelper.HeaderPanelBackground="Transparent">
      <!-- 日志调试模块 -->
      <TabItem Header="日志调试">
        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="0,8,8,8"
                Padding="16"
                Margin="0,4,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 说明 -->
            <TextBlock Grid.Row="0"
                       Text="模拟生成日志条目，用于测试日志面板的显示与筛选功能。"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- 日志来源 -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="来源" Style="{StaticResource LabelStyle}"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding AvailableSources}"
                        SelectedItem="{Binding SelectedSource}"
                        pu:ComboBoxHelper.CornerRadius="4">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource LogSourceToDisplayNameConverter}}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <!-- 日志等级 -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="等级" Style="{StaticResource LabelStyle}"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding AvailableLevels}"
                        SelectedItem="{Binding SelectedLevel}"
                        pu:ComboBoxHelper.CornerRadius="4"/>
            </Grid>

            <!-- 日志内容 -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="内容" Style="{StaticResource LabelStyle}"
                         VerticalAlignment="Top" Margin="0,6,8,0"/>
              <TextBox Grid.Column="1"
                       Text="{Binding LogContent, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       pu:TextBoxHelper.CornerRadius="4"
                       MinHeight="60"/>
            </Grid>

            <!-- 发送按钮 -->
            <Button Grid.Row="4"
                    Content="发送日志"
                    Command="{Binding SendLogCommand}"
                    HorizontalAlignment="Right"
                    Padding="20,8"
                    pu:ButtonHelper.CornerRadius="4"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource TextOnPrimaryBrush}"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
