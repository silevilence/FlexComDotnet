<Window x:Class="FlexComDotnet.Features.Settings.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        mc:Ignorable="d"
        Title="设置"
        Height="520"
        Width="460"
        MinHeight="450"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

  <Window.Resources>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="设置"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="应用程序配置与管理"
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <!-- 设置内容 -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- 调试设置 -->
        <Border Style="{StaticResource SectionBorderStyle}">
          <StackPanel>
            <TextBlock Text="调试设置" Style="{StaticResource SectionTitleStyle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="调试模式"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="启用后可按 F12 打开调试工具窗口"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,2,0,0"/>
              </StackPanel>
              <ToggleButton x:Name="DebugModeToggle"
                            Grid.Column="1"
                            IsChecked="{Binding IsDebugModeEnabled}"
                            VerticalAlignment="Center"
                            Width="44" Height="22"
                            pu:ToggleButtonHelper.CheckedBackground="{DynamicResource PrimaryBrush}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 面板管理 -->
        <Border Style="{StaticResource SectionBorderStyle}">
          <StackPanel>
            <TextBlock Text="面板管理" Style="{StaticResource SectionTitleStyle}"/>
            <TextBlock Text="控制各功能面板的显示与隐藏"
                       Style="{StaticResource LabelStyle}"
                       Margin="0,0,0,8"/>
            <ItemsControl x:Name="PanelList" ItemsSource="{Binding PanelItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsVisible, Mode=OneWay}"
                              VerticalAlignment="Center"
                              Click="PanelCheckBox_Click"
                              Tag="{Binding Id}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 日志目录 -->
        <Border Style="{StaticResource SectionBorderStyle}">
          <StackPanel>
            <TextBlock Text="日志目录" Style="{StaticResource SectionTitleStyle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding LogDirectory}"
                         Style="{StaticResource LabelStyle}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding LogDirectory}"/>
              <Button Grid.Column="1"
                      Content="打开文件夹"
                      Click="OpenLogDirectory_Click"
                      Padding="12,6"
                      pu:ButtonHelper.CornerRadius="4"
                      Background="{DynamicResource SurfaceHighBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      Cursor="Hand"
                      Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 关于信息 -->
        <Border Style="{StaticResource SectionBorderStyle}">
          <StackPanel>
            <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}"/>

            <!-- 版本号 -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="当前版本"
                         Style="{StaticResource LabelStyle}"
                         Margin="0,0,12,0"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding CurrentVersion}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- GitHub 链接 -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="GitHub"
                         Style="{StaticResource LabelStyle}"
                         Margin="0,0,12,0"/>
              <Button Grid.Column="1"
                      Content="silevilence/FlexComDotnet"
                      Style="{StaticResource LinkButtonStyle}"
                      Click="OpenGitHub_Click"
                      HorizontalAlignment="Left"/>
            </Grid>

            <!-- 许可声明 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="许可协议"
                         Style="{StaticResource LabelStyle}"
                         Margin="0,0,12,0"/>
              <TextBlock Grid.Column="1"
                         Text="MIT License"
                         FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
