<UserControl x:Class="FlexComDotnet.Features.Visualization.Views.DataVisualizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:local="clr-namespace:FlexComDotnet.Features.Visualization.Views"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Background="{DynamicResource SurfaceBrush}">

  <UserControl.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="MinWidth" Value="50"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶部工具栏: 解析器选择 + 采集控制 -->
    <Border Grid.Row="0"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <WrapPanel>
        <!-- 协议选择 -->
        <TextBlock Text="协议:" 
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Margin="0,0,4,0"/>
        <ComboBox x:Name="ParserComboBox"
                  Width="140"
                  ItemsSource="{Binding AvailableParsers}"
                  SelectedItem="{Binding SelectedParserName}"
                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                  pu:ComboBoxHelper.CornerRadius="4"
                  Background="{DynamicResource CardBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  FontSize="12"
                  Margin="0,0,8,0"/>

        <!-- 刷新解析器 -->
        <Button Style="{StaticResource ToolButtonStyle}"
                ToolTip="刷新解析器列表"
                Command="{Binding RefreshParsersCommand}">
          <Path Data="M12,4C14.1,4 16.1,4.8 17.6,6.3L20,4V10H14L16.2,7.8C15.1,6.7 13.6,6 12,6C8.7,6 6,8.7 6,12C6,15.3 8.7,18 12,18C14.8,18 17.1,16.2 17.8,13.5H19.9C19.1,17.4 15.9,20 12,20C7.6,20 4,16.4 4,12C4,7.6 7.6,4 12,4Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Width="14" Height="14"
                Stretch="Uniform"/>
        </Button>

        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="6,0"/>

        <!-- 开始/停止 -->
        <Button Style="{StaticResource ActionButtonStyle}"
                Content="▶ 开始"
                Command="{Binding StartCommand}"
                Margin="4,0"/>
        <Button Style="{StaticResource ActionButtonStyle}"
                Content="■ 停止"
                Command="{Binding StopCommand}"
                Margin="4,0"/>

        <!-- 暂停波形 -->
        <Button Style="{StaticResource ToolButtonStyle}"
                ToolTip="{Binding IsPaused, Converter={StaticResource InverseBoolConverter}, ConverterParameter=继续刷新|暂停波形}"
                Command="{Binding TogglePauseCommand}">
          <Path x:Name="PauseIcon"
                Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Width="14" Height="14"
                Stretch="Uniform"/>
        </Button>

        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="6,0"/>

        <!-- 清除数据 -->
        <Button Style="{StaticResource ToolButtonStyle}"
                ToolTip="清除所有数据"
                Command="{Binding ClearDataCommand}">
          <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Width="14" Height="14"
                Stretch="Uniform"/>
        </Button>

        <!-- 导出 CSV -->
        <Button Style="{StaticResource ToolButtonStyle}"
                ToolTip="导出 CSV 数据"
                Click="ExportCsv_Click">
          <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Width="14" Height="14"
                Stretch="Uniform"/>
        </Button>

        <!-- 导出 PNG -->
        <Button Style="{StaticResource ToolButtonStyle}"
                ToolTip="导出 PNG 图片"
                Click="ExportPng_Click">
          <Path Data="M5,3A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3H5M5,5H19V19H5V5M6,6V18H18V6H6M8.5,7.5A1.5,1.5 0 0,1 10,9A1.5,1.5 0 0,1 8.5,10.5A1.5,1.5 0 0,1 7,9A1.5,1.5 0 0,1 8.5,7.5M17,11L13,15L10.5,12.5L7,17H17V11Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Width="14" Height="14"
                Stretch="Uniform"/>
        </Button>
      </WrapPanel>
    </Border>

    <!-- 通道配置区域 -->
    <Border Grid.Row="1"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 通道列表 (水平显示) -->
        <ItemsControl ItemsSource="{Binding Channels}"
                      Grid.Column="0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource BackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="6,3"
                      Margin="0,0,4,2"
                      Cursor="Hand"
                      MouseLeftButtonUp="ChannelTag_MouseLeftButtonUp">
                <StackPanel Orientation="Horizontal">
                  <!-- 颜色标识 -->
                  <Ellipse Width="10" Height="10"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center">
                    <Ellipse.Fill>
                      <SolidColorBrush Color="{Binding Color, Converter={x:Static local:ColorStringConverter.Instance}}"/>
                    </Ellipse.Fill>
                  </Ellipse>
                  <!-- 通道名 -->
                  <TextBlock Text="{Binding DisplayName}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11"
                             VerticalAlignment="Center"/>
                  <!-- 可见性指示 -->
                  <TextBlock Text="👁"
                             FontSize="10"
                             Margin="4,0,0,0"
                             VerticalAlignment="Center"
                             Opacity="{Binding IsVisible, Converter={x:Static local:BoolToOpacityConverter.Instance}}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 添加/移除通道 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding AvailableFields}"
                    SelectedItem="{Binding SelectedFieldName}"
                    Width="100"
                    pu:ComboBoxHelper.CornerRadius="4"
                    Background="{DynamicResource CardBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    FontSize="11"
                    Margin="0,0,4,0"/>
          <Button Style="{StaticResource ToolButtonStyle}"
                  ToolTip="添加通道"
                  Command="{Binding AddChannelCommand}">
            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                  Fill="{DynamicResource SuccessBrush}"
                  Width="14" Height="14"
                  Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource ToolButtonStyle}"
                  ToolTip="移除选中通道"
                  Command="{Binding RemoveChannelCommand}">
            <Path Data="M19,13H5V11H19V13Z"
                  Fill="{DynamicResource ErrorBrush}"
                  Width="14" Height="14"
                  Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource ToolButtonStyle}"
                  ToolTip="切换通道可见性"
                  Command="{Binding ToggleChannelVisibilityCommand}">
            <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="14" Height="14"
                  Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 图表区域 -->
    <Grid Grid.Row="2" MinHeight="200">
      <scottplot:WpfPlot x:Name="WpfPlot" Margin="0"/>
      <!-- 数据点提示框 -->
      <Border x:Name="DataTipBorder"
              Visibility="Collapsed"
              Background="#DD2D2D30"
              BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8,4"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="10"
              IsHitTestVisible="False">
        <TextBlock x:Name="DataTipText"
                   Foreground="#CCCCCC"
                   FontSize="11"
                   FontFamily="Consolas"/>
      </Border>
    </Grid>

    <!-- 底部状态栏 -->
    <Border Grid.Row="3"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 状态消息 -->
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"/>

        <!-- 数据点统计 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="数据点: "
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="11"/>
          <TextBlock Text="{Binding TotalDataPoints}"
                     Foreground="{DynamicResource AccentBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"/>
          <TextBlock Text=" | 最大: "
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="11"/>
          <TextBox Text="{Binding MaxDataPoints, UpdateSourceTrigger=PropertyChanged}"
                   Background="{DynamicResource BackgroundBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   Width="60"
                   FontSize="11"
                   VerticalContentAlignment="Center"
                   Padding="2"
                   pu:TextBoxHelper.CornerRadius="3"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
