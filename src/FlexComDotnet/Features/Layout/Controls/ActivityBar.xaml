<UserControl x:Class="FlexComDotnet.Features.Layout.Controls.ActivityBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="52"
             Background="{DynamicResource SidebarBrush}">
    
    <UserControl.Resources>
        <!-- 底部普通按钮样式 -->
        <Style x:Key="TechActivityBarRegularButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PressedColor}" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 主题切换按钮样式 (三态: 浅色/深色/跟随系统) -->
        <Style x:Key="ThemeCycleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 主要按钮区域（预留扩展） -->
        <StackPanel x:Name="MainButtons" Grid.Row="0">
        </StackPanel>
        
        <!-- 底部功能区域 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <!-- 分隔线 -->
            <Border Height="1" 
                    Background="{DynamicResource BorderBrush}" 
                    Opacity="0.3"
                    Margin="8,4"/>
            
            <!-- 协议解析器按钮 -->
            <Button x:Name="ProtocolParserButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="协议解析器"
                    Click="ProtocolParserButton_Click">
                <Path Data="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75M12,15C13.5,15 16.5,15.75 16.5,17.25V18H7.5V17.25C7.5,15.75 10.5,15 12,15Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
            
            <!-- 校验计算器按钮 -->
            <Button x:Name="ChecksumCalculatorButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="校验和计算器"
                    Click="ChecksumCalculatorButton_Click">
                <Path Data="M4,2H14L20,8V22A2,2 0 0,1 18,24H4A2,2 0 0,1 2,22V4A2,2 0 0,1 4,2M13,3.5V9H18.5L13,3.5M7,14H9V15H10V13H7V12H11V16H9V15H8V17H11V18H7V14M14,12H18V13H15V14H17A1,1 0 0,1 18,15V17A1,1 0 0,1 17,18H14V17H17V16H15A1,1 0 0,1 14,15V13A1,1 0 0,1 15,12H14V12Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
            
            <!-- 检查更新按钮 -->
            <Button x:Name="UpdateButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="检查更新"
                    Click="UpdateButton_Click">
                <Grid>
                    <!-- 无更新时的刷新图标 -->
                    <Path x:Name="NoUpdateIcon"
                          Data="M21,10.12H14.22L16.96,7.38C14.23,4.65 9.81,4.65 7.08,7.38C4.35,10.11 4.35,14.53 7.08,17.26C9.81,19.99 14.23,19.99 16.96,17.26C18.32,15.9 19,14.12 19,12.34H21C21,14.64 20.05,16.94 18.14,18.85C14.32,22.67 8.03,22.67 4.22,18.85C0.4,15.03 0.4,8.74 4.22,4.92C8.03,1.1 14.32,1.1 18.14,4.92L21,2V10.12Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Visibility="Visible"/>
                    <!-- 有更新时的下载图标（绿色） -->
                    <Path x:Name="HasUpdateIcon"
                          Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                          Fill="{DynamicResource SuccessBrush}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Visibility="Collapsed"/>
                </Grid>
            </Button>
            
            <!-- 主题切换按钮 (三态: 浅色→深色→跟随系统) -->
            <Button x:Name="ThemeCycleButton"
                    Style="{StaticResource ThemeCycleButtonStyle}"
                    Click="ThemeCycleButton_Click">
                <Grid>
                    <!-- 太阳图标 (浅色模式) -->
                    <TextBlock x:Name="SunIcon" 
                               Text="☀" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <!-- 月亮图标 (深色模式) -->
                    <TextBlock x:Name="MoonIcon" 
                               Text="🌙" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>
                    <!-- 自动图标 (跟随系统) -->
                    <TextBlock x:Name="AutoIcon" 
                               Text="🔄" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Button>
            
            <!-- 面板管理按钮 -->
            <Button x:Name="SettingsButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="设置"
                    Click="SettingsButton_Click">
                <Path Data="M19.14,12.94C19.18,12.64 19.2,12.33 19.2,12C19.2,11.68 19.18,11.36 19.13,11.06L21.16,9.48C21.34,9.34 21.39,9.07 21.28,8.87L19.36,5.55C19.24,5.33 18.99,5.26 18.77,5.33L16.38,6.29C15.88,5.91 15.35,5.59 14.76,5.35L14.4,2.81C14.36,2.57 14.16,2.4 13.92,2.4H10.08C9.84,2.4 9.65,2.57 9.61,2.81L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33C5.02,5.25 4.77,5.33 4.65,5.55L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48L4.89,11.06C4.84,11.36 4.8,11.69 4.8,12C4.8,12.31 4.82,12.64 4.87,12.94L2.85,14.52C2.67,14.66 2.62,14.93 2.73,15.13L4.65,18.45C4.77,18.67 5.02,18.74 5.24,18.67L7.63,17.71C8.13,18.09 8.66,18.41 9.25,18.65L9.61,21.19C9.65,21.43 9.84,21.6 10.08,21.6H13.92C14.16,21.6 14.36,21.43 14.39,21.19L14.75,18.65C15.34,18.41 15.88,18.09 16.37,17.71L18.76,18.67C18.98,18.75 19.23,18.67 19.35,18.45L21.27,15.13C21.39,14.91 21.34,14.66 21.15,14.52L19.14,12.94M12,15.6C10.02,15.6 8.4,13.98 8.4,12C8.4,10.02 10.02,8.4 12,8.4C13.98,8.4 15.6,10.02 15.6,12C15.6,13.98 13.98,15.6 12,15.6Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
