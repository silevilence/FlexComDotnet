<UserControl x:Class="FlexComDotnet.Features.Layout.Controls.ActivityBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="52"
             Background="{DynamicResource SidebarBrush}">
    
    <UserControl.Resources>
        <!-- 科技感侧边栏按钮样式 -->
        <Style x:Key="TechActivityBarButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                CornerRadius="0,4,4,0"
                                Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 底部普通按钮样式 -->
        <Style x:Key="TechActivityBarRegularButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PressedColor}" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 主题切换按钮样式 (三态: 浅色/深色/跟随系统) -->
        <Style x:Key="ThemeCycleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 主要按钮区域 -->
        <StackPanel x:Name="MainButtons" Grid.Row="0">
            <!-- 左侧面板切换 -->
            <ToggleButton x:Name="LeftPanelButton"
                          Style="{StaticResource TechActivityBarButtonStyle}"
                          ToolTip="切换左侧面板 (串口配置)"
                          Checked="LeftPanelButton_Checked"
                          Unchecked="LeftPanelButton_Unchecked"
                          IsChecked="True">
                <Path Data="M3,3H11V11H3V3M3,13H11V21H3V13M13,3H21V11H13V3M13,13H21V21H13V13"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </ToggleButton>
            
            <!-- 右侧面板切换 -->
            <ToggleButton x:Name="RightPanelButton"
                          Style="{StaticResource TechActivityBarButtonStyle}"
                          ToolTip="切换右侧面板 (指令列表)"
                          Checked="RightPanelButton_Checked"
                          Unchecked="RightPanelButton_Unchecked"
                          IsChecked="True">
                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V7H9V15H11V10H13V15H15V12H17V17Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </ToggleButton>
            
            <!-- 底部面板切换 -->
            <ToggleButton x:Name="BottomPanelButton"
                          Style="{StaticResource TechActivityBarButtonStyle}"
                          ToolTip="切换底部面板"
                          Checked="BottomPanelButton_Checked"
                          Unchecked="BottomPanelButton_Unchecked"
                          IsChecked="False">
                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V14H19V19M19,12H5V5H19V12Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </ToggleButton>
        </StackPanel>
        
        <!-- 底部功能区域 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <!-- 分隔线 -->
            <Border Height="1" 
                    Background="{DynamicResource BorderBrush}" 
                    Opacity="0.3"
                    Margin="8,4"/>
            
            <!-- 校验计算器按钮 -->
            <Button x:Name="ChecksumCalculatorButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="校验和计算器"
                    Click="ChecksumCalculatorButton_Click">
                <Path Data="M4,2H14L20,8V22A2,2 0 0,1 18,24H4A2,2 0 0,1 2,22V4A2,2 0 0,1 4,2M13,3.5V9H18.5L13,3.5M7,14H9V15H10V13H7V12H11V16H9V15H8V17H11V18H7V14M14,12H18V13H15V14H17A1,1 0 0,1 18,15V17A1,1 0 0,1 17,18H14V17H17V16H15A1,1 0 0,1 14,15V13A1,1 0 0,1 15,12H14V12Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
            
            <!-- 主题切换按钮 (三态: 浅色→深色→跟随系统) -->
            <Button x:Name="ThemeCycleButton"
                    Style="{StaticResource ThemeCycleButtonStyle}"
                    Click="ThemeCycleButton_Click">
                <Grid>
                    <!-- 太阳图标 (浅色模式) -->
                    <TextBlock x:Name="SunIcon" 
                               Text="☀" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <!-- 月亮图标 (深色模式) -->
                    <TextBlock x:Name="MoonIcon" 
                               Text="🌙" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>
                    <!-- 自动图标 (跟随系统) -->
                    <TextBlock x:Name="AutoIcon" 
                               Text="🔄" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Button>
            
            <!-- 设置按钮 -->
            <Button x:Name="SettingsButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="设置"
                    Click="SettingsButton_Click">
                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
