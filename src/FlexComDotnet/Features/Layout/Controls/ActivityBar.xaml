<UserControl x:Class="FlexComDotnet.Features.Layout.Controls.ActivityBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="52"
             Background="{DynamicResource SidebarBrush}">
    
    <UserControl.Resources>
        <!-- 科技感侧边栏按钮样式 -->
        <Style x:Key="TechActivityBarButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                CornerRadius="0,4,4,0"
                                Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 底部普通按钮样式 -->
        <Style x:Key="TechActivityBarRegularButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PressedColor}" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 主题切换按钮样式 (三态: 浅色/深色/跟随系统) -->
        <Style x:Key="ThemeCycleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnSidebarBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverColor}" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 主要按钮区域 -->
        <StackPanel x:Name="MainButtons" Grid.Row="0">
            <!-- 左侧面板切换 -->
            <ToggleButton x:Name="LeftPanelButton"
                          Style="{StaticResource TechActivityBarButtonStyle}"
                          ToolTip="切换左侧面板 (串口配置)"
                          Checked="LeftPanelButton_Checked"
                          Unchecked="LeftPanelButton_Unchecked"
                          IsChecked="True">
                <Path Data="M3,3H11V11H3V3M3,13H11V21H3V13M13,3H21V11H13V3M13,13H21V21H13V13"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </ToggleButton>
            
            <!-- 右侧面板切换 -->
            <ToggleButton x:Name="RightPanelButton"
                          Style="{StaticResource TechActivityBarButtonStyle}"
                          ToolTip="切换右侧面板 (指令列表)"
                          Checked="RightPanelButton_Checked"
                          Unchecked="RightPanelButton_Unchecked"
                          IsChecked="True">
                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H14V5H19V19M12,19H5V5H12V19Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </ToggleButton>
            
            <!-- 底部面板切换 -->
            <ToggleButton x:Name="BottomPanelButton"
                          Style="{StaticResource TechActivityBarButtonStyle}"
                          ToolTip="切换底部面板"
                          Checked="BottomPanelButton_Checked"
                          Unchecked="BottomPanelButton_Unchecked"
                          IsChecked="False">
                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V14H19V19M19,12H5V5H19V12Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </ToggleButton>
        </StackPanel>
        
        <!-- 底部功能区域 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <!-- 分隔线 -->
            <Border Height="1" 
                    Background="{DynamicResource BorderBrush}" 
                    Opacity="0.3"
                    Margin="8,4"/>
            
            <!-- 协议解析器按钮 -->
            <Button x:Name="ProtocolParserButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="协议解析器"
                    Click="ProtocolParserButton_Click">
                <Path Data="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75M12,15C13.5,15 16.5,15.75 16.5,17.25V18H7.5V17.25C7.5,15.75 10.5,15 12,15Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
            
            <!-- 数据可视化按钮 -->
            <Button x:Name="DataVisualizationButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="数据可视化 (实时示波器)"
                    Click="DataVisualizationButton_Click">
                <Path Data="M3,13H5V11H7V13H9V7H11V13H13V5H15V13H17V9H19V13H21V15H3V13Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
            
            <!-- 校验计算器按钮 -->
            <Button x:Name="ChecksumCalculatorButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="校验和计算器"
                    Click="ChecksumCalculatorButton_Click">
                <Path Data="M4,2H14L20,8V22A2,2 0 0,1 18,24H4A2,2 0 0,1 2,22V4A2,2 0 0,1 4,2M13,3.5V9H18.5L13,3.5M7,14H9V15H10V13H7V12H11V16H9V15H8V17H11V18H7V14M14,12H18V13H15V14H17A1,1 0 0,1 18,15V17A1,1 0 0,1 17,18H14V17H17V16H15A1,1 0 0,1 14,15V13A1,1 0 0,1 15,12H14V12Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
            
            <!-- 检查更新按钮 -->
            <Button x:Name="UpdateButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="检查更新"
                    Click="UpdateButton_Click">
                <Grid>
                    <!-- 无更新时的刷新图标 -->
                    <Path x:Name="NoUpdateIcon"
                          Data="M21,10.12H14.22L16.96,7.38C14.23,4.65 9.81,4.65 7.08,7.38C4.35,10.11 4.35,14.53 7.08,17.26C9.81,19.99 14.23,19.99 16.96,17.26C18.32,15.9 19,14.12 19,12.34H21C21,14.64 20.05,16.94 18.14,18.85C14.32,22.67 8.03,22.67 4.22,18.85C0.4,15.03 0.4,8.74 4.22,4.92C8.03,1.1 14.32,1.1 18.14,4.92L21,2V10.12Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Visibility="Visible"/>
                    <!-- 有更新时的下载图标（绿色） -->
                    <Path x:Name="HasUpdateIcon"
                          Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                          Fill="{DynamicResource SuccessBrush}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Visibility="Collapsed"/>
                </Grid>
            </Button>
            
            <!-- 主题切换按钮 (三态: 浅色→深色→跟随系统) -->
            <Button x:Name="ThemeCycleButton"
                    Style="{StaticResource ThemeCycleButtonStyle}"
                    Click="ThemeCycleButton_Click">
                <Grid>
                    <!-- 太阳图标 (浅色模式) -->
                    <TextBlock x:Name="SunIcon" 
                               Text="☀" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <!-- 月亮图标 (深色模式) -->
                    <TextBlock x:Name="MoonIcon" 
                               Text="🌙" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>
                    <!-- 自动图标 (跟随系统) -->
                    <TextBlock x:Name="AutoIcon" 
                               Text="🔄" 
                               FontFamily="Segoe UI Symbol"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Button>
            
            <!-- 面板管理按钮 -->
            <Button x:Name="SettingsButton"
                    Style="{StaticResource TechActivityBarRegularButtonStyle}"
                    ToolTip="面板管理"
                    Click="SettingsButton_Click">
                <Path Data="M3,3H11V11H3V3M3,13H11V21H3V13M13,3H21V11H13V3M13,13H21V21H13V13M5,5V9H9V5H5M5,15V19H9V15H5M15,5V9H19V5H15M15,15V19H19V15H15Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
