<Window x:Class="FlexComDotnet.Features.Driver.Views.SerialMonitorRawRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原帧 / 原始记录" Width="820" Height="560" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding EventLabel}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Grid.Row="1" Text="{Binding Content}" Margin="0,8,0,12" TextWrapping="Wrap"/>
    <TextBox Grid.Row="2" Text="{Binding RawDetails, Mode=OneWay}" IsReadOnly="True"
             FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" FontSize="13"
             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
             BorderBrush="{DynamicResource BorderBrush}" Padding="12"
             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
             SelectionBrush="{DynamicResource SelectedBrush}" SelectionOpacity="1"/>
    <Button Grid.Row="3" Content="关闭" IsCancel="True" IsDefault="True" Click="Close_Click"
            HorizontalAlignment="Right" Padding="20,6" Margin="0,12,0,0"/>
  </Grid>
</Window>
