<Window x:Class="FlexComDotnet.Features.Protocol.Views.RxProtocolParseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        mc:Ignorable="d"
        Title="协议解析" 
        Height="500" 
        Width="600"
        MinHeight="350"
        MinWidth="450"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}">

  <Window.Resources>
    <Style x:Key="ThemedDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="ThemedDataGridCell" TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 协议选择 -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="协议:" 
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <ComboBox x:Name="ProtocolComboBox" Grid.Column="1"
                DisplayMemberPath="Name"
                SelectionChanged="ProtocolComboBox_SelectionChanged"
                Background="{DynamicResource CardBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                pu:ComboBoxHelper.CornerRadius="4"/>
      <Button Grid.Column="2" Content="自动检测" Margin="8,0,0,0"
              Click="AutoDetect_Click"
              Background="{DynamicResource CardBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              pu:ButtonHelper.CornerRadius="4"
              Padding="12,4" Cursor="Hand"/>
    </Grid>

    <!-- Hex 数据输入 -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Hex 数据:" 
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBox x:Name="HexInputTextBox" Grid.Column="1"
               FontFamily="Consolas"
               Background="{DynamicResource CardBrush}"
               Foreground="{DynamicResource TextPrimaryBrush}"
               BorderBrush="{DynamicResource BorderBrush}"
               CaretBrush="{DynamicResource PrimaryBrush}"
               pu:TextBoxHelper.CornerRadius="4"
               Padding="8,4"/>
      <Button Grid.Column="2" Content="解析" Margin="8,0,0,0"
              Click="Parse_Click"
              Background="{DynamicResource PrimaryBrush}"
              Foreground="{DynamicResource TextOnPrimaryBrush}"
              BorderThickness="0"
              pu:ButtonHelper.CornerRadius="4"
              Padding="16,4" Cursor="Hand" FontWeight="SemiBold"/>
    </Grid>

    <!-- 解析状态 + Hex 显示切换 -->
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Grid.Column="0"
                 FontSize="12"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
      <CheckBox x:Name="HexDisplayToggle" Grid.Column="1"
                Content="值列 Hex 显示"
                IsChecked="False"
                Checked="HexDisplayToggle_Changed"
                Unchecked="HexDisplayToggle_Changed"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontSize="12"/>
    </Grid>

    <!-- 解析结果 -->
    <Border Grid.Row="3" 
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <DataGrid x:Name="FieldsDataGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                Background="Transparent"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0"
                RowBackground="Transparent"
                AlternatingRowBackground="{DynamicResource CardBrush}"
                CanUserSortColumns="False"
                SelectionUnit="Cell"
                ClipboardCopyMode="IncludeHeader"
                ColumnHeaderStyle="{StaticResource ThemedDataGridColumnHeader}"
                CellStyle="{StaticResource ThemedDataGridCell}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="字段名" Binding="{Binding Name}" Width="Auto" MinWidth="80">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,4"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="值" Binding="{Binding DisplayValue}" Width="*" MinWidth="100">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="8,4"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Hex" Binding="{Binding HexValue}" Width="Auto" MinWidth="80">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Padding" Value="8,4"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="Auto" MinWidth="60">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Padding" Value="8,4"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="80">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Padding" Value="8,4"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- 校验状态 -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock x:Name="ChecksumStatusText" 
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
  </Grid>
</Window>
