<Window x:Class="FlexComDotnet.Features.Protocol.Views.TxProtocolBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        mc:Ignorable="d"
        Title="协议组帧" 
        Height="520" 
        Width="600"
        MinHeight="380"
        MinWidth="450"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 协议选择 -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="协议:" 
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <ComboBox x:Name="ProtocolComboBox" Grid.Column="1"
                DisplayMemberPath="Name"
                SelectionChanged="ProtocolComboBox_SelectionChanged"
                Background="{DynamicResource CardBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                pu:ComboBoxHelper.CornerRadius="4"/>
      <Button Grid.Column="2" Content="反向解析" Margin="8,0,0,0"
              Click="ReverseParse_Click"
              Background="{DynamicResource CardBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              pu:ButtonHelper.CornerRadius="4"
              Padding="12,4" Cursor="Hand"
              ToolTip="将当前发送区内容用选中协议反向解析"/>
    </Grid>

    <!-- 字段输入区域 -->
    <Border Grid.Row="1" 
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0,0,0,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <ItemsControl x:Name="FieldInputsControl">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" 
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold" FontSize="12"/>
                  <TextBlock Text="{Binding DataTypeDisplay}" 
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="10"/>
                </StackPanel>
                <TextBox Grid.Column="1" 
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas"
                         Background="{DynamicResource CardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         CaretBrush="{DynamicResource PrimaryBrush}"
                         pu:TextBoxHelper.CornerRadius="4"
                         pu:TextBoxHelper.Watermark="{Binding Description}"
                         Padding="8,4" Margin="8,0"/>
                <CheckBox Grid.Column="2" Content="Hex"
                          IsChecked="{Binding IsHexMode}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextSecondaryBrush}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 构建结果 -->
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="结果:" 
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBox x:Name="BuildResultTextBox" Grid.Column="1"
               IsReadOnly="True"
               FontFamily="Consolas"
               Background="{DynamicResource CardBrush}"
               Foreground="{DynamicResource PrimaryBrush}"
               BorderBrush="{DynamicResource BorderBrush}"
               pu:TextBoxHelper.CornerRadius="4"
               Padding="8,4"/>
    </Grid>

    <!-- 状态信息 -->
    <TextBlock x:Name="StatusText" Grid.Row="3" 
               Margin="0,0,0,8"
               FontSize="12"
               Foreground="{DynamicResource TextSecondaryBrush}"/>

    <!-- 操作按钮 -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="组帧" Margin="0,0,8,0"
              Click="Build_Click"
              Background="{DynamicResource PrimaryBrush}"
              Foreground="{DynamicResource TextOnPrimaryBrush}"
              BorderThickness="0"
              pu:ButtonHelper.CornerRadius="4"
              Padding="16,6" Cursor="Hand" FontWeight="SemiBold"/>
      <Button Content="覆盖回填" Margin="0,0,8,0"
              Click="OverwriteBackfill_Click"
              Background="{DynamicResource CardBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              pu:ButtonHelper.CornerRadius="4"
              Padding="12,6" Cursor="Hand"
              ToolTip="将组帧结果覆盖发送区内容"/>
      <Button Content="追加回填"
              Click="AppendBackfill_Click"
              Background="{DynamicResource CardBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              pu:ButtonHelper.CornerRadius="4"
              Padding="12,6" Cursor="Hand"
              ToolTip="将组帧结果追加到发送区尾部"/>
    </StackPanel>
  </Grid>
</Window>
