<Window x:Class="FlexComDotnet.Features.Protocol.Views.ProtocolDefinitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:converters="clr-namespace:FlexComDotnet.Converters"
        xmlns:models="clr-namespace:FlexComDotnet.Core.Features.Protocol.Models;assembly=FlexComDotnet.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="协议定义编辑器" 
        Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    
    <Window.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:ProtocolTypeDisplayConverter x:Key="ProtocolTypeDisplayConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <ObjectDataProvider x:Key="DataTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DataType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        
        <ObjectDataProvider x:Key="EndiannessValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:Endianness"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        
        <Style x:Key="ThemedDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        
        <Style x:Key="ThemedDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="ThemedDataGridCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧: 协议列表 -->
        <Border Style="{StaticResource SectionBorder}" Grid.Column="0" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="协议列表" Style="{StaticResource SectionTitle}"/>
                
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Definitions}"
                         SelectedItem="{Binding SelectedDefinition}"
                         Background="Transparent"
                         BorderThickness="0"
                         ContextMenuOpening="ListBox_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="新建">
                                <MenuItem Header="通用协议" Command="{Binding NewDefinitionCommand}"/>
                                <MenuItem Header="DL/T 645-2007" Command="{Binding NewDlt645DefinitionCommand}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="编辑" Command="{Binding EditDefinitionCommand}"/>
                            <Separator/>
                            <MenuItem Header="删除" Command="{Binding DeleteDefinitionCommand}" Foreground="{DynamicResource ErrorBrush}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ProtocolType, Converter={StaticResource ProtocolTypeDisplayConverter}, StringFormat=' [{0}]'}" 
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        
        <!-- 中间: 编辑区域 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel IsEnabled="{Binding IsEditing}">
                <!-- 基本信息 -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding EditingDefinition.Name, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.CornerRadius="4" Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="1" Text="描述" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingDefinition.Description, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.CornerRadius="4" Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="2" Text="帧头 (Hex)" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding IsGenericProtocol, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingDefinition.Header, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.CornerRadius="4" 
                                     pu:TextBoxHelper.Watermark="如: AA BB"
                                     Margin="0,0,0,8"
                                     Visibility="{Binding IsGenericProtocol, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            
                            <TextBlock Grid.Row="3" Text="帧尾 (Hex)" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding IsGenericProtocol, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingDefinition.Trailer, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.CornerRadius="4"
                                     pu:TextBoxHelper.Watermark="如: FF"
                                     Visibility="{Binding IsGenericProtocol, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 长度配置 - 仅通用协议显示 -->
                <Border Style="{StaticResource SectionBorder}"
                        Visibility="{Binding IsGenericProtocol, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="帧长度" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox Content="启用长度字段" 
                                          IsChecked="{Binding HasLengthFieldConfig, Mode=OneWay}"
                                          Command="{Binding ToggleLengthFieldCommand}"
                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="最小长度" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding EditingDefinition.MinFrameLength, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.CornerRadius="4" Margin="0,0,8,0"/>
                            
                            <TextBlock Grid.Column="2" Text="最大长度" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Text="{Binding EditingDefinition.MaxFrameLength, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.CornerRadius="4"
                                     pu:TextBoxHelper.Watermark="0=不限"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- DL/T 645 协议说明 - 仅645协议显示 -->
                <Border Style="{StaticResource SectionBorder}"
                        Visibility="{Binding IsDlt645Protocol, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="DL/T 645-2007 协议说明" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="• 帧格式: 68 + 地址(6B) + 68 + 控制码 + 长度 + 数据域 + 校验 + 16"/><LineBreak/>
                            <Run Text="• 地址: 小端序BCD码，自动解析为12位表号"/><LineBreak/>
                            <Run Text="• 数据域: 自动执行 -33H 还原"/><LineBreak/>
                            <Run Text="• 校验: 算术累加和"/><LineBreak/>
                            <Run Text="• 数据标识: 自动查询内置字典获取物理量名称和单位"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- 字段定义 -->
                <Border Style="{StaticResource SectionBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据字段" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="添加" Command="{Binding AddFieldCommand}"
                                        pu:ButtonHelper.CornerRadius="4" Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="删除" Command="{Binding RemoveFieldCommand}"
                                        pu:ButtonHelper.CornerRadius="4" Padding="8,4"
                                        Foreground="{DynamicResource ErrorBrush}"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Grid.Row="1" 
                                   Text="起始索引: 相对于帧起始位置 (0-based)，长度: 字节数" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,8"/>
                        
                        <DataGrid Grid.Row="3" 
                                  ItemsSource="{Binding EditingFields}"
                                  SelectedItem="{Binding SelectedField}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Style="{StaticResource ThemedDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ThemedDataGridColumnHeader}"
                                  CellStyle="{StaticResource ThemedDataGridCell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="字段名" Binding="{Binding Name}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="起始 (字节)" Binding="{Binding StartIndex}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="长度 (字节)" Binding="{Binding Length}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="数据类型" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataType}" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Padding="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding Source={StaticResource DataTypeValues}}"
                                                      Background="{DynamicResource CardBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      pu:ComboBoxHelper.CornerRadius="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="字节序" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Endianness}" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Padding="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Endianness, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding Source={StaticResource EndiannessValues}}"
                                                      Background="{DynamicResource CardBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      pu:ComboBoxHelper.CornerRadius="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                
                <!-- 位域定义 -->
                <Border Style="{StaticResource SectionBorder}" 
                        Visibility="{Binding SelectedField, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="位域定义" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding SelectedField.Name, StringFormat=' - {0}'}" 
                                           Style="{StaticResource SectionTitle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="添加位域" Command="{Binding AddBitFieldCommand}"
                                        pu:ButtonHelper.CornerRadius="4" Padding="8,4" Margin="0,0,4,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Grid.Row="1" 
                                   Text="位偏移: 从 LSB (bit 0) 开始计数，掩码: 可选，优先于位偏移/位数" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,8"/>
                        
                        <DataGrid Grid.Row="2" 
                                  ItemsSource="{Binding SelectedField.BitFields}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Style="{StaticResource ThemedDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ThemedDataGridColumnHeader}"
                                  CellStyle="{StaticResource ThemedDataGridCell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="位偏移" Binding="{Binding BitOffset}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="位数" Binding="{Binding BitCount}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="掩码 (Hex)" Binding="{Binding Mask}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×" 
                                                    Command="{Binding DataContext.RemoveBitFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    pu:ButtonHelper.CornerRadius="4"
                                                    Foreground="{DynamicResource ErrorBrush}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                
                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="取消" Command="{Binding CancelEditCommand}"
                            pu:ButtonHelper.CornerRadius="4" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="保存" Command="{Binding SaveDefinitionCommand}"
                            pu:ButtonHelper.CornerRadius="4" Padding="16,8"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 右侧: 测试区域 -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="测试解析" Style="{StaticResource SectionTitle}"/>
                    
                    <TextBlock Text="测试帧 (Hex)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TestFrameHex, UpdateSourceTrigger=PropertyChanged}"
                             pu:TextBoxHelper.CornerRadius="4"
                             pu:TextBoxHelper.Watermark="AA BB 01 02 03..."
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"/>
                    
                    <Button Content="解析" Command="{Binding TestParseCommand}"
                            pu:ButtonHelper.CornerRadius="4" Padding="16,8" Margin="0,8"
                            HorizontalAlignment="Stretch"/>
                    
                    <Border Background="{DynamicResource SurfaceBrush}" 
                            CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding ParseResult.Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <Border BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="0,0,0,1" Padding="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontFamily="Consolas"/>
                                                
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                           Text="{Binding HexValue}"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </Border>
                                        <!-- 位域解析结果 -->
                                        <ItemsControl ItemsSource="{Binding BitFields}" Margin="12,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" 
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Value}"
                                                                   FontSize="11"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
