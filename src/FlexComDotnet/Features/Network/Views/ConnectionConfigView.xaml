<UserControl x:Class="FlexComDotnet.Features.Network.Views.ConnectionConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="280"
             Background="{DynamicResource SurfaceBrush}">
    
    <UserControl.Resources>
        <converters:BaudRateDisplayConverter x:Key="BaudRateDisplayConverter"/>
        <converters:DataBitsDisplayConverter x:Key="DataBitsDisplayConverter"/>
        <converters:StopBitsDisplayConverter x:Key="StopBitsDisplayConverter"/>
        <converters:ParityDisplayConverter x:Key="ParityDisplayConverter"/>
        <converters:FlowControlDisplayConverter x:Key="FlowControlDisplayConverter"/>
        <converters:ConnectionTypeDisplayConverter x:Key="ConnectionTypeDisplayConverter"/>
        <converters:ConnectionTypeToVisibilityConverter x:Key="ConnectionTypeToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="ConfigLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        
        <Style x:Key="ConfigComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ComboBoxHelper.CornerRadius" Value="4"/>
            <Setter Property="pu:ComboBoxHelper.ShadowColor" Value="{DynamicResource PrimaryColor}"/>
        </Style>
        
        <Style x:Key="ConfigTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="pu:TextBoxHelper.CornerRadius" Value="4"/>
        </Style>
        
        <Style x:Key="ConfigCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        
        <Style x:Key="TechButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Resources>
    
    <Border Padding="12" 
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                          Fill="{DynamicResource PrimaryBrush}"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="连接配置" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                
                <!-- 连接类型选择 -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="类型" Style="{StaticResource ConfigLabelStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableConnectionTypes}"
                              SelectedItem="{Binding SelectedConnectionType}"
                              IsEnabled="{Binding IsConfigEnabled}"
                              Style="{StaticResource ConfigComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ConnectionTypeDisplayConverter}}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                
                <!-- ==================== 串口配置区域 ==================== -->
                <StackPanel Visibility="{Binding IsSerialMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="串口参数" Style="{StaticResource SectionTitleStyle}"/>
                    
                    <!-- 串口选择 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsConfigEnabled}"
                                  Style="{StaticResource ConfigComboBoxStyle}"/>
                        
                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Margin="4,4,0,4"
                                ToolTip="刷新串口列表"
                                Command="{Binding RefreshPortsCommand}"
                                IsEnabled="{Binding IsConfigEnabled}"
                                Style="{StaticResource TechButtonStyle}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="0">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                    
                    <!-- 波特率 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="波特率" Style="{StaticResource ConfigLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableBaudRates}"
                                  SelectedItem="{Binding SelectedBaudRate}"
                                  IsEnabled="{Binding IsConfigEnabled}"
                                  Style="{StaticResource ConfigComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource BaudRateDisplayConverter}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <!-- 数据位 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="数据位" Style="{StaticResource ConfigLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableDataBits}"
                                  SelectedItem="{Binding SelectedDataBits}"
                                  IsEnabled="{Binding IsConfigEnabled}"
                                  Style="{StaticResource ConfigComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DataBitsDisplayConverter}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <!-- 停止位 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="停止位" Style="{StaticResource ConfigLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableStopBits}"
                                  SelectedItem="{Binding SelectedStopBits}"
                                  IsEnabled="{Binding IsConfigEnabled}"
                                  Style="{StaticResource ConfigComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource StopBitsDisplayConverter}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <!-- 校验位 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="校验位" Style="{StaticResource ConfigLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableParities}"
                                  SelectedItem="{Binding SelectedParity}"
                                  IsEnabled="{Binding IsConfigEnabled}"
                                  Style="{StaticResource ConfigComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ParityDisplayConverter}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <!-- 流控 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="流控" Style="{StaticResource ConfigLabelStyle}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableFlowControls}"
                                  SelectedItem="{Binding SelectedFlowControl}"
                                  IsEnabled="{Binding IsConfigEnabled}"
                                  Style="{StaticResource ConfigComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource FlowControlDisplayConverter}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <!-- 帧间隔超时 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="帧间隔(ms)" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FrameIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"/>
                    </Grid>
                    
                    <!-- 最大帧长度 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="最大帧(Byte)" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MaxFrameBytes, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
                
                <!-- ==================== TCP 客户端配置区域 ==================== -->
                <StackPanel Visibility="{Binding IsTcpClientMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="服务器参数" Style="{StaticResource SectionTitleStyle}"/>
                    
                    <!-- 服务器地址 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="地址" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TcpClientHost, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="127.0.0.1"/>
                    </Grid>
                    
                    <!-- 端口 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="端口" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TcpClientPort, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="8080"/>
                    </Grid>
                    
                    <!-- 连接超时 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="超时(ms)" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TcpClientConnectTimeout, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="5000"/>
                    </Grid>
                    
                    <!-- 选项 -->
                    <CheckBox Content="启用 KeepAlive"
                              IsChecked="{Binding TcpClientKeepAlive}"
                              IsEnabled="{Binding IsConfigEnabled}"
                              Style="{StaticResource ConfigCheckBoxStyle}"/>
                    
                    <CheckBox Content="禁用 Nagle 算法 (NoDelay)"
                              IsChecked="{Binding TcpClientNoDelay}"
                              IsEnabled="{Binding IsConfigEnabled}"
                              Style="{StaticResource ConfigCheckBoxStyle}"/>
                </StackPanel>
                
                <!-- ==================== TCP 服务器配置区域 ==================== -->
                <StackPanel Visibility="{Binding IsTcpServerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="监听参数" Style="{StaticResource SectionTitleStyle}"/>
                    
                    <!-- 监听地址 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="地址" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TcpServerListenAddress, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="0.0.0.0"/>
                    </Grid>
                    
                    <!-- 端口 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="端口" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TcpServerPort, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="8080"/>
                    </Grid>
                    
                    <!-- 最大连接数 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="最大连接" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TcpServerMaxConnections, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="10"/>
                    </Grid>
                    
                    <!-- 已连接客户端数 -->
                    <Grid Margin="0,4" Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="客户端" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBlock Grid.Column="1" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding ConnectedClientsCount, Mode=OneWay}"/>
                            <Run Text=" 个已连接"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                
                <!-- ==================== UDP 配置区域 ==================== -->
                <StackPanel Visibility="{Binding IsUdpMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="本地参数" Style="{StaticResource SectionTitleStyle}"/>
                    
                    <!-- 本地端口 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="本地端口" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding UdpLocalPort, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="0 (自动分配)"/>
                    </Grid>
                    
                    <!-- 已绑定端口 -->
                    <Grid Margin="0,4" Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="绑定端口" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding UdpBoundPort}" 
                                   VerticalAlignment="Center"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </Grid>
                    
                    <TextBlock Text="默认发送目标" Style="{StaticResource SectionTitleStyle}"/>
                    
                    <!-- 远程地址 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="远程地址" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding UdpRemoteHost, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="127.0.0.1"/>
                    </Grid>
                    
                    <!-- 远程端口 -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="远程端口" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding UdpRemotePort, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsConfigEnabled}"
                                 Style="{StaticResource ConfigTextBoxStyle}"
                                 pu:TextBoxHelper.Watermark="8080"/>
                    </Grid>
                    
                    <!-- 启用广播 -->
                    <CheckBox Content="启用广播"
                              IsChecked="{Binding UdpEnableBroadcast}"
                              IsEnabled="{Binding IsConfigEnabled}"
                              Style="{StaticResource ConfigCheckBoxStyle}"/>
                </StackPanel>
                
                <!-- ==================== 连接按钮 ==================== -->
                <Button Content="{Binding ConnectionButtonText}"
                        Height="40"
                        Margin="0,16,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Command="{Binding ToggleConnectionCommand}"
                        pu:ButtonHelper.CornerRadius="6"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- ==================== 状态信息 ==================== -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6" 
                        Padding="10"
                        VerticalAlignment="Top"
                        Margin="0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 连接状态指示灯 -->
                        <Border Grid.Column="0"
                                Width="12"
                                Height="12"
                                CornerRadius="6"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" 
                                                                      ShadowDepth="0" 
                                                                      Color="#22C55E" 
                                                                      Opacity="0.8"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
