<UserControl x:Class="FlexComDotnet.Features.Logging.Views.LogPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="800"
             Background="{DynamicResource SurfaceBrush}">

  <UserControl.Resources>
    <converters:UnifiedLogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
    <converters:UnifiedLogLevelToEmojiConverter x:Key="LogLevelToEmojiConverter"/>
    <converters:UnifiedLogLevelToLabelConverter x:Key="LogLevelToLabelConverter"/>
    <converters:LogSourceToDisplayNameConverter x:Key="LogSourceToDisplayNameConverter"/>

    <!-- 筛选按钮样式 -->
    <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 工具栏按钮样式 -->
    <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <!-- 工具栏 -->
      <RowDefinition Height="Auto"/>
      <!-- 日志列表 -->
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ========================= 工具栏 ========================= -->
    <Border Grid.Row="0" Padding="6,4"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <!-- 右侧：清空按钮 -->
        <Button DockPanel.Dock="Right" Content="🗑"
                Style="{StaticResource ToolButtonStyle}"
                Command="{Binding ClearLogsCommand}"
                ToolTip="清空日志" Width="26" Height="26"/>

        <!-- 左侧：筛选控件 -->
        <StackPanel Orientation="Horizontal">
          <!-- 日志等级筛选 -->
          <ToggleButton Content="🔍 DBG" IsChecked="{Binding ShowDebug}"
                        Style="{StaticResource FilterToggleStyle}" ToolTip="调试"/>
          <ToggleButton Content="💡 INF" IsChecked="{Binding ShowInfo}"
                        Style="{StaticResource FilterToggleStyle}" ToolTip="信息"/>
          <ToggleButton Content="⚠️ WRN" IsChecked="{Binding ShowWarning}"
                        Style="{StaticResource FilterToggleStyle}" ToolTip="警告"/>
          <ToggleButton Content="❌ ERR" IsChecked="{Binding ShowError}"
                        Style="{StaticResource FilterToggleStyle}" ToolTip="错误"/>

          <!-- 分隔线 -->
          <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="6,4"/>

          <!-- 来源模块多选筛选 -->
          <ToggleButton x:Name="SourceFilterToggle" 
                        Style="{StaticResource FilterToggleStyle}"
                        ToolTip="按来源模块筛选">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="📦 来源" Margin="0,0,4,0"/>
              <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked, ElementName=SourceFilterToggle, Mode=TwoWay}"
                 StaysOpen="False" PlacementTarget="{Binding ElementName=SourceFilterToggle}"
                 Placement="Bottom" HorizontalOffset="0" VerticalOffset="2"
                 AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="4">
              <StackPanel>
                <!-- 快捷操作栏 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="全选" FontSize="10" Padding="6,2" Margin="2,0"
                          Style="{StaticResource ToolButtonStyle}" Width="Auto" Height="22"
                          Command="{Binding SelectAllSourcesCommand}"/>
                  <Button Content="反选" FontSize="10" Padding="6,2" Margin="2,0"
                          Style="{StaticResource ToolButtonStyle}" Width="Auto" Height="22"
                          Command="{Binding InvertSourcesCommand}"/>
                  <Button Content="全不选" FontSize="10" Padding="6,2" Margin="2,0"
                          Style="{StaticResource ToolButtonStyle}" Width="Auto" Height="22"
                          Command="{Binding SelectNoneSourcesCommand}"/>
                </StackPanel>
                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,2"/>
                <!-- 来源选项列表 -->
                <ItemsControl ItemsSource="{Binding SourceFilters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected}" Margin="4,2"
                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                                Cursor="Hand">
                        <TextBlock Text="{Binding DisplayName}"/>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Popup>

          <!-- 分隔线 -->
          <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="6,4"/>

          <!-- 正则模式切换 -->
          <ToggleButton Content=".*" IsChecked="{Binding UseRegex}"
                        Style="{StaticResource FilterToggleStyle}" ToolTip="正则表达式"
                        FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="Bold"
                        MinWidth="30"/>

          <!-- 关键词搜索 -->
          <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                   FontSize="11" Padding="4,2" MinWidth="120"
                   Background="{DynamicResource CardBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   pu:TextBoxHelper.Watermark="🔎 搜索..."
                   pu:TextBoxHelper.CornerRadius="4">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRegexError}" Value="True">
                    <Setter Property="BorderBrush" Value="#E06C75"/>
                    <Setter Property="ToolTip" Value="正则表达式语法错误"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ========================= 日志列表 ========================= -->
    <ListBox Grid.Row="1" x:Name="LogListBox"
             ItemsSource="{Binding FilteredEntries}"
             Background="{DynamicResource BackgroundBrush}"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             FontFamily="Cascadia Code, Consolas, Courier New"
             FontSize="11"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             SelectionMode="Extended">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="复制" Click="CopyLogMenuItem_Click" InputGestureText="Ctrl+C"/>
          <MenuItem Header="全选" Click="SelectAllLogMenuItem_Click" InputGestureText="Ctrl+A"/>
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="8,2"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <!-- 时间戳 -->
            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,6,0"/>
            <!-- Emoji 图标 (彩色渲染) -->
            <emoji:TextBlock Text="{Binding Level, Converter={StaticResource LogLevelToEmojiConverter}}"
                             Margin="0,0,4,0"/>
            <!-- 等级标签 -->
            <TextBlock Text="{Binding Level, Converter={StaticResource LogLevelToLabelConverter}}"
                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                       FontWeight="SemiBold"
                       MinWidth="28" Margin="0,0,6,0"/>
            <!-- 来源模块 -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="3"
                    Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Source, Converter={StaticResource LogSourceToDisplayNameConverter}}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="10"/>
            </Border>
            <!-- 消息内容 -->
            <emoji:TextBlock Text="{Binding Message}"
                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
