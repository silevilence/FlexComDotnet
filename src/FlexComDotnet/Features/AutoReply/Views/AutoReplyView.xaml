<UserControl x:Class="FlexComDotnet.Features.AutoReply.Views.AutoReplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexComDotnet.Features.AutoReply.Views"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:models="clr-namespace:FlexComDotnet.Core.Features.AutoReply.Models;assembly=FlexComDotnet.Core"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             xmlns:emojiBehavior="clr-namespace:FlexComDotnet.Features.EmojiSupport.Behaviors"
             xmlns:emojiControls="clr-namespace:FlexComDotnet.Features.EmojiSupport.Controls"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="350"
             Background="{DynamicResource SurfaceBrush}">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:EnumToIntConverter x:Key="EnumToIntConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:TextBoxHelper.CornerRadius" Value="4"/>
        </Style>

        <!-- 可展开文本框样式：焦点时放大（使用动画避免布局重入崩溃） -->
        <Style x:Key="ExpandableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TechTextBoxStyle}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MaxHeight" Value="24"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="GotKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MinHeight" To="60" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="120" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="LostKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MinHeight" To="24" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="24" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- 保存/取消按钮样式 -->
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <Style x:Key="TechComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ComboBoxHelper.CornerRadius" Value="4"/>
        </Style>
        
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 类型标签样式 -->
        <Style x:Key="TypeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题和全局控制 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="自动回复" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 启动/停止按钮 -->
                <Button Grid.Column="2" Command="{Binding ToggleRunningCommand}"
                        Padding="12,6" MinWidth="70"
                        pu:ButtonHelper.CornerRadius="4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="▶ 启动"/>
                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="⏹ 停止"/>
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
        <!-- 全局设置 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="延迟(ms):" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <TextBox Style="{StaticResource TechTextBoxStyle}" Width="70"
                         Text="{Binding GlobalDelayMs, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- 规则工具栏 -->
        <Border Grid.Row="2" Padding="4,6" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 添加按钮组 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button ToolTip="添加匹配规则" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding AddMatchRuleCommand}" Content="M" FontSize="10" FontWeight="Bold"/>
                    <Button ToolTip="添加顺序规则" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding AddSequentialRuleCommand}" Content="S" FontSize="10" FontWeight="Bold"/>
                    <Button ToolTip="添加协议规则" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding AddProtocolRuleCommand}" Content="P" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                
                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🗑" ToolTip="删除规则" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding RemoveRuleCommand}"/>
                    <Button Content="⬆" ToolTip="上移" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding MoveRuleUpCommand}"/>
                    <Button Content="⬇" ToolTip="下移" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding MoveRuleDownCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 统一规则池列表 -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Rules}"
                 SelectedItem="{Binding SelectedRule}"
                 ItemContainerStyle="{StaticResource ListItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                        
                        <!-- 类型标签 -->
                        <Border Grid.Column="1" Style="{StaticResource TypeBadgeStyle}">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.15"/>
                            </Border.Background>
                            <TextBlock Text="{Binding TypeDisplayName}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <emoji:TextBlock Text="{Binding Name}" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <emoji:TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="3" Text="{Binding SortOrder, StringFormat=[{0}]}"
                                   FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- 规则编辑区（选中规则后显示） -->
        <Border Grid.Row="4" Padding="10" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding SelectedRule, Converter={StaticResource NullToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                <StackPanel>
                    <!-- 公共字段 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" 
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <emojiControls:EmojiTextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Margin="0,2"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="描述:" 
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <emojiControls:EmojiTextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding SelectedRule.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Margin="0,2"/>
                    </Grid>
                    
                    <!-- 匹配规则专属字段 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRule.Type}" Value="{x:Static models:ReplyMode.Match}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="触发条件:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ExpandableTextBoxStyle}"
                                         Text="{Binding SelectedRule.MatchConfig.TriggerPattern, UpdateSourceTrigger=PropertyChanged}"
                                         pu:TextBoxHelper.Watermark="如: AA BB CC 或 HELLO"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource TechComboBoxStyle}"
                                          SelectedIndex="{Binding SelectedRule.MatchConfig.MatchType, Converter={StaticResource EnumToIntConverter}}"
                                          Width="90" Margin="5,0,0,0">
                                    <ComboBoxItem Content="Hex包含"/>
                                    <ComboBoxItem Content="ASCII包含"/>
                                    <ComboBoxItem Content="Hex精确"/>
                                    <ComboBoxItem Content="ASCII精确"/>
                                </ComboBox>
                            </Grid>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="响应内容:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ExpandableTextBoxStyle}"
                                         Text="{Binding SelectedRule.MatchConfig.ResponseContent, UpdateSourceTrigger=PropertyChanged}"
                                         pu:TextBoxHelper.Watermark="如: DD EE FF"/>
                                <CheckBox Grid.Column="1" Content="Hex" Margin="8,0,0,0"
                                          IsChecked="{Binding SelectedRule.MatchConfig.IsResponseHex}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                    
                    <!-- 顺序规则专属字段 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRule.Type}" Value="{x:Static models:ReplyMode.Sequential}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- 顺序帧控制条 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="➕" ToolTip="添加帧" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding AddFrameCommand}"/>
                                <Button Content="🗑" ToolTip="删除帧" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding RemoveFrameCommand}"/>
                                <Button Content="⬆" ToolTip="上移" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding MoveFrameUpCommand}"/>
                                <Button Content="⬇" ToolTip="下移" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding MoveFrameDownCommand}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <CheckBox Content="循环" IsChecked="{Binding SelectedRule.SequentialConfig.EnableLoop}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="重置" ToolTip="重置索引" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding ResetRuleStateCommand}" Width="Auto" Padding="8,4"/>
                                <TextBlock Text="#" VerticalAlignment="Center" Margin="8,0,2,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedRule.CurrentFrameIndex}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" MinWidth="15"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 帧列表 -->
                        <ListBox ItemsSource="{Binding EditingFrames}"
                                 SelectedItem="{Binding SelectedEditingFrame}"
                                 ItemContainerStyle="{StaticResource ListItemStyle}"
                                 Background="Transparent" BorderThickness="1"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 MaxHeight="150"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SortOrder, StringFormat=[{0}]}" 
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="2">
                                            <emoji:TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Content}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- 帧编辑 -->
                        <Border Padding="0,6,0,0"
                                Visibility="{Binding SelectedEditingFrame, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="帧名称:" 
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <emojiControls:EmojiTextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding SelectedEditingFrame.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,2"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="内容:" 
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ExpandableTextBoxStyle}"
                                             Text="{Binding SelectedEditingFrame.Content, UpdateSourceTrigger=PropertyChanged}"
                                             pu:TextBoxHelper.Watermark="如: 01 02 03 或 OK"/>
                                    <CheckBox Grid.Column="1" Content="Hex" Margin="8,0,0,0"
                                              IsChecked="{Binding SelectedEditingFrame.IsHexMode}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                    
                    <!-- 协议规则专属字段 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRule.Type}" Value="{x:Static models:ReplyMode.Protocol}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="协议:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource TechComboBoxStyle}"
                                          ItemsSource="{Binding AvailableProtocols}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedRule.ProtocolConfig.ProtocolName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="🔄" ToolTip="刷新协议" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding RefreshAvailableProtocolsCommand}" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>
                        
                        <!-- 动态字段输入区 -->
                        <TextBlock Text="数据字段" FontWeight="SemiBold" Margin="0,8,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding ProtocolFieldInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName, StringFormat={}{0}:}" 
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1" 
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource CardBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 CaretBrush="{DynamicResource PrimaryBrush}"
                                                 pu:TextBoxHelper.Watermark="{Binding DefaultValue}"
                                                 pu:TextBoxHelper.CornerRadius="4"/>
                                        <CheckBox Grid.Column="2" Content="Hex" Margin="6,0,0,0"
                                                  IsChecked="{Binding IsHexMode}"
                                                  VerticalAlignment="Center" FontSize="11"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                                   FontSize="10" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} | {1}">
                                                    <Binding Path="DataTypeDisplay"/>
                                                    <Binding Path="Description"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Button Content="🔄 刷新字段" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding RefreshProtocolFieldsCommand}" 
                                HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- 保存/取消按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="取消" Style="{StaticResource CancelButtonStyle}"
                                Command="{Binding CancelRuleCommand}" Margin="0,0,8,0"/>
                        <Button Content="💾 保存" Style="{StaticResource SaveButtonStyle}"
                                Command="{Binding SaveRuleCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- 状态栏 -->
        <Border Grid.Row="5" Padding="10,6" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="已停止"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Text" Value="运行中"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
