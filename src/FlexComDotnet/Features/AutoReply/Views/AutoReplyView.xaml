<UserControl x:Class="FlexComDotnet.Features.AutoReply.Views.AutoReplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexComDotnet.Features.AutoReply.Views"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="350"
             Background="{DynamicResource SurfaceBrush}">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:EnumToIntConverter x:Key="EnumToIntConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:TextBoxHelper.CornerRadius" Value="4"/>
        </Style>

        <!-- 可展开文本框样式：焦点时放大（使用动画避免布局重入崩溃） -->
        <Style x:Key="ExpandableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TechTextBoxStyle}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MaxHeight" Value="24"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="GotKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MinHeight" To="60" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="120" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="LostKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MinHeight" To="24" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="24" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- 保存/取消按钮样式 -->
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <Style x:Key="TechComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ComboBoxHelper.CornerRadius" Value="4"/>
        </Style>
        
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- 科技风格 TabItem 样式 -->
        <Style x:Key="TechTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 科技风格 TabControl 样式 -->
        <Style x:Key="TechTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TechTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Tab Header 区域 -->
                            <Border Grid.Row="0" 
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" 
                                          HorizontalAlignment="Stretch"/>
                            </Border>
                            
                            <!-- Tab Content 区域 -->
                            <Border Grid.Row="1" 
                                    Background="{DynamicResource SurfaceBrush}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题和全局控制 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="自动回复" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 启动/停止按钮 -->
                <Button Grid.Column="2" Command="{Binding ToggleRunningCommand}"
                        Padding="12,6" MinWidth="70"
                        pu:ButtonHelper.CornerRadius="4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="▶ 启动"/>
                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="⏹ 停止"/>
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
        <!-- 全局设置 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="延迟(ms):" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <TextBox Grid.Column="1" Style="{StaticResource TechTextBoxStyle}"
                         Text="{Binding GlobalDelayMs, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5,0,15,0" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="2" Text="模式:" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <ComboBox Grid.Column="3" Style="{StaticResource TechComboBoxStyle}"
                          SelectedIndex="{Binding ActiveMode, Converter={StaticResource EnumToIntConverter}}"
                          Margin="5,0,0,0" VerticalAlignment="Center">
                    <ComboBoxItem Content="匹配回复"/>
                    <ComboBoxItem Content="顺序回复"/>
                </ComboBox>
            </Grid>
        </Border>
        
        <!-- TabControl: 匹配规则 / 顺序帧 -->
        <TabControl Grid.Row="2" Style="{StaticResource TechTabControlStyle}">
            
            <!-- 匹配回复 Tab -->
            <TabItem Header="匹配规则">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 工具栏 -->
                    <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➕" ToolTip="添加规则" Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding AddMatchRuleCommand}"/>
                            <Button Content="🗑" ToolTip="删除规则" Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding RemoveMatchRuleCommand}"/>
                            <Button Content="⬆" ToolTip="上移" Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding MoveMatchRuleUpCommand}"/>
                            <Button Content="⬇" ToolTip="下移" Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding MoveMatchRuleDownCommand}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 规则列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding MatchRules}"
                             SelectedItem="{Binding SelectedMatchRule}"
                             ItemContainerStyle="{StaticResource ListItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TriggerPattern}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- 规则编辑区 -->
                    <Border Grid.Row="2" Padding="10" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding SelectedMatchRule, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TechTextBoxStyle}"
                                     Text="{Binding SelectedMatchRule.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="触发条件:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ExpandableTextBoxStyle}"
                                         Text="{Binding SelectedMatchRule.TriggerPattern, UpdateSourceTrigger=PropertyChanged}"
                                         pu:TextBoxHelper.Watermark="如: AA BB CC 或 HELLO"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource TechComboBoxStyle}"
                                          SelectedIndex="{Binding SelectedMatchRule.MatchType, Converter={StaticResource EnumToIntConverter}}"
                                          Width="90" Margin="5,0,0,0">
                                    <ComboBoxItem Content="Hex包含"/>
                                    <ComboBoxItem Content="ASCII包含"/>
                                    <ComboBoxItem Content="Hex精确"/>
                                    <ComboBoxItem Content="ASCII精确"/>
                                </ComboBox>
                            </Grid>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="响应内容:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ExpandableTextBoxStyle}"
                                         Text="{Binding SelectedMatchRule.ResponseContent, UpdateSourceTrigger=PropertyChanged}"
                                         pu:TextBoxHelper.Watermark="如: DD EE FF"/>
                                <CheckBox Grid.Column="1" Content="Hex" Margin="8,0,0,0"
                                          IsChecked="{Binding SelectedMatchRule.IsResponseHex}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="描述:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ExpandableTextBoxStyle}"
                                     Text="{Binding SelectedMatchRule.Description, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2"/>
                            
                            <!-- 保存/取消按钮 -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="取消" Style="{StaticResource CancelButtonStyle}"
                                        Command="{Binding CancelMatchRuleCommand}" Margin="0,0,8,0"/>
                                <Button Content="💾 保存" Style="{StaticResource SaveButtonStyle}"
                                        Command="{Binding SaveMatchRuleCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- 顺序回复 Tab -->
            <TabItem Header="顺序帧">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 工具栏 -->
                    <Border Grid.Row="0" Padding="4,6" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 左侧按钮组 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="➕" ToolTip="添加帧" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding AddSequentialFrameCommand}"/>
                                <Button Content="🗑" ToolTip="删除帧" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding RemoveSequentialFrameCommand}"/>
                                <Button Content="⬆" ToolTip="上移" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding MoveSequentialFrameUpCommand}"/>
                                <Button Content="⬇" ToolTip="下移" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding MoveSequentialFrameDownCommand}"/>
                            </StackPanel>
                            
                            <!-- 右侧控制组 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <CheckBox Content="循环" IsChecked="{Binding EnableLoop}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="重置" ToolTip="重置索引" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding ResetSequenceIndexCommand}" Width="Auto" Padding="8,4"/>
                                <TextBlock Text="#" VerticalAlignment="Center" Margin="8,0,2,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding CurrentFrameIndex}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" MinWidth="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 帧列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding SequentialFrames}"
                             SelectedItem="{Binding SelectedSequentialFrame}"
                             ItemContainerStyle="{StaticResource ListItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SortOrder, StringFormat=[{0}]}" 
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Content}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- 帧编辑区 -->
                    <Border Grid.Row="2" Padding="10" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding SelectedSequentialFrame, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TechTextBoxStyle}"
                                     Text="{Binding SelectedSequentialFrame.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="内容:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ExpandableTextBoxStyle}"
                                         Text="{Binding SelectedSequentialFrame.Content, UpdateSourceTrigger=PropertyChanged}"
                                         pu:TextBoxHelper.Watermark="如: 01 02 03 或 OK"/>
                                <CheckBox Grid.Column="1" Content="Hex" Margin="8,0,0,0"
                                          IsChecked="{Binding SelectedSequentialFrame.IsHexMode}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="描述:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ExpandableTextBoxStyle}"
                                     Text="{Binding SelectedSequentialFrame.Description, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2"/>
                            
                            <!-- 保存/取消按钮 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="取消" Style="{StaticResource CancelButtonStyle}"
                                        Command="{Binding CancelSequentialFrameCommand}" Margin="0,0,8,0"/>
                                <Button Content="💾 保存" Style="{StaticResource SaveButtonStyle}"
                                        Command="{Binding SaveSequentialFrameCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- 日志 Tab -->
            <TabItem Header="日志">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 统计和控制 -->
                    <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 统计信息 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Rx:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding ReceiveCount}" Foreground="{DynamicResource PrimaryBrush}" 
                                           FontWeight="Bold" Margin="3,0,10,0" FontSize="11"/>
                                <TextBlock Text="Tx:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding ReplyCount}" Foreground="{DynamicResource SuccessBrush}" 
                                           FontWeight="Bold" Margin="3,0,0,0" FontSize="11"/>
                            </StackPanel>
                            
                            <!-- 控制按钮 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="重置" Style="{StaticResource ToolButtonStyle}" 
                                        Width="Auto" Padding="8,4" FontSize="11"
                                        Command="{Binding ResetCountersCommand}"/>
                                <Button Content="清空" Style="{StaticResource ToolButtonStyle}" 
                                        Width="Auto" Padding="8,4" FontSize="11"
                                        Command="{Binding ClearLogsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 日志列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding ReplyLogs}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="300"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FontFamily="pack://application:,,,/Fonts/#Maple Mono NF CN"
                             FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TimestampString}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" | " Foreground="{DynamicResource BorderBrush}"/>
                                            <TextBlock Text="{Binding RuleName}" 
                                                       Foreground="{DynamicResource PrimaryBrush}" FontWeight="Medium"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Rx: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ReceivedDataHex}" 
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tx: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ReplyDataHex}" 
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- 状态栏 -->
        <Border Grid.Row="3" Padding="10,6" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="已停止"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Text" Value="运行中"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
