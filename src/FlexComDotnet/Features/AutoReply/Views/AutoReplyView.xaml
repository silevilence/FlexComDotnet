<UserControl x:Class="FlexComDotnet.Features.AutoReply.Views.AutoReplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexComDotnet.Features.AutoReply.Views"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:models="clr-namespace:FlexComDotnet.Core.Features.AutoReply.Models;assembly=FlexComDotnet.Core"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             xmlns:emojiBehavior="clr-namespace:FlexComDotnet.Features.EmojiSupport.Behaviors"
             xmlns:emojiControls="clr-namespace:FlexComDotnet.Features.EmojiSupport.Controls"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="350"
             Background="{DynamicResource SurfaceBrush}">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:EnumToIntConverter x:Key="EnumToIntConverter"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:TextBoxHelper.CornerRadius" Value="4"/>
        </Style>

        <!-- 可展开文本框样式：焦点时放大（使用动画避免布局重入崩溃） -->
        <Style x:Key="ExpandableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TechTextBoxStyle}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MaxHeight" Value="24"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="GotKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MinHeight" To="60" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="120" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="LostKeyboardFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MinHeight" To="24" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="24" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- 保存/取消按钮样式 -->
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <Style x:Key="TechComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ComboBoxHelper.CornerRadius" Value="4"/>
        </Style>
        
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 类型标签样式 -->
        <Style x:Key="TypeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题和全局控制 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="自动回复" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 启动/停止按钮 -->
                <Button Grid.Column="2" Command="{Binding ToggleRunningCommand}"
                        Padding="12,6" MinWidth="70"
                        pu:ButtonHelper.CornerRadius="4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="▶ 启动"/>
                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="⏹ 停止"/>
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
        <!-- 全局设置 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="延迟(ms):" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox Style="{StaticResource TechTextBoxStyle}" Width="70"
                             Text="{Binding DebounceWindowMs, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="决策模式:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding AvailableDecisionModes}"
                              SelectedItem="{Binding DecisionMode}"
                              Style="{StaticResource TechComboBoxStyle}"
                              Width="90" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- 规则工具栏 -->
        <Border Grid.Row="2" Padding="4,6" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 添加按钮组 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button ToolTip="添加匹配规则" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding AddMatchRuleCommand}" Content="M" FontSize="10" FontWeight="Bold"/>
                    <Button ToolTip="添加顺序规则" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding AddSequentialRuleCommand}" Content="S" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                
                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🗑" ToolTip="删除规则" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding RemoveRuleCommand}"/>
                    <Button Content="⬆" ToolTip="上移" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding MoveRuleUpCommand}"/>
                    <Button Content="⬇" ToolTip="下移" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding MoveRuleDownCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 统一规则池列表 -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Rules}"
                 SelectedItem="{Binding SelectedRule}"
                 ItemContainerStyle="{StaticResource ListItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                        
                        <!-- 类型标签 -->
                        <Border Grid.Column="1" Style="{StaticResource TypeBadgeStyle}">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.15"/>
                            </Border.Background>
                            <TextBlock Text="{Binding TypeDisplayName}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <emoji:TextBlock Text="{Binding Name}" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <emoji:TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="3" Text="{Binding SortOrder, StringFormat=[{0}]}"
                                   FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- 规则编辑区（选中规则后显示） -->
        <Border Grid.Row="4" Padding="10" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding SelectedRule, Converter={StaticResource NullToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                <StackPanel>
                    <!-- 公共字段 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" 
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <emojiControls:EmojiTextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Margin="0,2"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="描述:" 
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <emojiControls:EmojiTextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding SelectedRule.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Margin="0,2"/>
                    </Grid>
                    
                    <!-- 匹配规则专属字段 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRule.Type}" Value="{x:Static models:ReplyMode.Match}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="匹配类型:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TechComboBoxStyle}"
                                      SelectedIndex="{Binding SelectedRule.MatchConfig.MatchType, Converter={StaticResource EnumToIntConverter}}"
                                      Margin="0,2">
                                <ComboBoxItem Content="Hex包含"/>
                                <ComboBoxItem Content="ASCII包含"/>
                                <ComboBoxItem Content="Hex精确"/>
                                <ComboBoxItem Content="ASCII精确"/>
                                <ComboBoxItem Content="协议解析"/>
                            </ComboBox>

                            <!-- 文本触发条件（非协议解析模式时显示） -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="触发条件:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule.MatchConfig.MatchType}" Value="{x:Static models:MatchType.ProtocolParse}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding SelectedRule.MatchConfig.TriggerPattern, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.Watermark="如: AA BB CC 或 HELLO" Margin="0,2">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ExpandableTextBoxStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule.MatchConfig.MatchType}" Value="{x:Static models:MatchType.ProtocolParse}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- 协议触发条件（协议解析模式时显示） -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="触发协议:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule.MatchConfig.MatchType}" Value="{x:Static models:MatchType.ProtocolParse}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule.MatchConfig.MatchType}" Value="{x:Static models:MatchType.ProtocolParse}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource TechComboBoxStyle}"
                                          ItemsSource="{Binding AvailableProtocols}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedRule.MatchConfig.TriggerProtocolName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="⟳ 协议" ToolTip="刷新协议列表" 
                                        Style="{StaticResource ToolButtonStyle}" Width="Auto" Padding="6,4"
                                        Command="{Binding RefreshAvailableProtocolsCommand}" Margin="4,0,0,0"/>
                                <Button Grid.Column="2" Content="⟳ 字段" ToolTip="刷新断言字段列表" 
                                        Style="{StaticResource ToolButtonStyle}" Width="Auto" Padding="6,4"
                                        Command="{Binding RefreshAssertionFieldNamesCommand}" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>

                        <!-- 字段断言区（协议解析匹配模式时显示） - 在响应模式之前 -->
                        <Border Margin="0,6,0,0" Padding="6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRule.MatchConfig.MatchType}" Value="{x:Static models:MatchType.ProtocolParse}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字段断言 (AND)" FontWeight="SemiBold" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="➕" ToolTip="添加断言" Style="{StaticResource ToolButtonStyle}"
                                            Command="{Binding AddAssertionCommand}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding EditingAssertions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          SelectedItem="{Binding FieldName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          ItemsSource="{Binding DataContext.AssertionFieldNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Background="{DynamicResource CardBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush}"
                                                          pu:ComboBoxHelper.CornerRadius="4"
                                                          Margin="0,0,4,0" FontSize="11"/>
                                                <ComboBox Grid.Column="1"
                                                          SelectedIndex="{Binding Operator, Converter={StaticResource EnumToIntConverter}}"
                                                          Margin="0,0,4,0" FontSize="11"
                                                          Background="{DynamicResource CardBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush}"
                                                          pu:ComboBoxHelper.CornerRadius="4">
                                                    <ComboBoxItem Content="=="/>
                                                    <ComboBoxItem Content="&gt;"/>
                                                    <ComboBoxItem Content="&gt;="/>
                                                    <ComboBoxItem Content="&lt;"/>
                                                    <ComboBoxItem Content="&lt;="/>
                                                    <ComboBoxItem Content="Hex含"/>
                                                </ComboBox>
                                                <TextBox Grid.Column="2" Text="{Binding ExpectedValue, UpdateSourceTrigger=PropertyChanged}"
                                                         pu:TextBoxHelper.Watermark="期望值"
                                                         Background="{DynamicResource CardBrush}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         pu:TextBoxHelper.CornerRadius="4"
                                                         Padding="4,2" Margin="0,0,4,0" FontSize="11"/>
                                                <Button Grid.Column="3" Content="🗑" ToolTip="删除"
                                                        Style="{StaticResource ToolButtonStyle}" Width="24" Height="24"
                                                        Command="{Binding DataContext.RemoveAssertionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 响应模式选择 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="响应模式:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <RadioButton Content="纯文本" GroupName="ResponseMode"
                                             IsChecked="{Binding SelectedRule.MatchConfig.ResponseMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=0}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                <RadioButton Content="协议组帧" GroupName="ResponseMode"
                                             IsChecked="{Binding SelectedRule.MatchConfig.ResponseMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=1}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 纯文本响应内容（ResponseMode == PlainText 时显示） -->
                        <Grid Margin="0,6,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRule.MatchConfig.ResponseMode}" Value="{x:Static models:ResponseBuildMode.ProtocolBuild}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="响应内容:" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ExpandableTextBoxStyle}"
                                     Text="{Binding SelectedRule.MatchConfig.ResponseContent, UpdateSourceTrigger=PropertyChanged}"
                                     pu:TextBoxHelper.Watermark="如: DD EE FF 或 {fieldName}"/>
                            <CheckBox Grid.Column="2" Content="Hex" Margin="8,0,0,0"
                                      IsChecked="{Binding SelectedRule.MatchConfig.IsResponseHex}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 协议组帧响应（ResponseMode == ProtocolBuild 时显示） -->
                        <Border Margin="0,6,0,0" Padding="6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRule.MatchConfig.ResponseMode}" Value="{x:Static models:ResponseBuildMode.ProtocolBuild}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="响应协议:" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableProtocols}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Name"
                                              SelectedValue="{Binding SelectedRule.MatchConfig.ProtocolResponse.ProtocolName, UpdateSourceTrigger=PropertyChanged}"
                                              Background="{DynamicResource CardBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              pu:ComboBoxHelper.CornerRadius="4" FontSize="11"/>
                                    <Button Grid.Column="2" Content="⟳ 字段" ToolTip="刷新响应协议字段" 
                                            Style="{StaticResource ToolButtonStyle}" Width="Auto" Padding="6,4"
                                            Command="{Binding RefreshMatchResponseFieldsCommand}" Margin="4,0,0,0"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding MatchResponseFieldInputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName, StringFormat={}{0}:}" 
                                                           VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <!-- 普通输入模式 -->
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         pu:TextBoxHelper.Watermark="{Binding Description}"
                                                         Background="{DynamicResource CardBrush}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         pu:TextBoxHelper.CornerRadius="4"
                                                         Padding="4,2" FontSize="11">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToggleMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <CheckBox Grid.Column="2" Content="Hex" 
                                                          IsChecked="{Binding IsHexMode}"
                                                          VerticalAlignment="Center" Margin="4,0,0,0"
                                                          Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToggleMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <!-- 二元切换模式 -->
                                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToggleMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding ToggleFalseLabel}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                               FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToggleChecked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ToggleButton IsChecked="{Binding IsToggleChecked}" VerticalAlignment="Center"
                                                                  pu:ToggleButtonHelper.CornerRadius="8" MinWidth="36"/>
                                                    <TextBlock Text="{Binding ToggleTrueLabel}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                               FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToggleChecked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- 顺序规则专属字段 -->
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRule.Type}" Value="{x:Static models:ReplyMode.Sequential}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- 顺序帧控制条 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="➕" ToolTip="添加帧" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding AddFrameCommand}"/>
                                <Button Content="🗑" ToolTip="删除帧" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding RemoveFrameCommand}"/>
                                <Button Content="⬆" ToolTip="上移" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding MoveFrameUpCommand}"/>
                                <Button Content="⬇" ToolTip="下移" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding MoveFrameDownCommand}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <CheckBox Content="循环" IsChecked="{Binding SelectedRule.SequentialConfig.EnableLoop}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="重置" ToolTip="重置索引" Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding ResetRuleStateCommand}" Width="Auto" Padding="8,4"/>
                                <TextBlock Text="#" VerticalAlignment="Center" Margin="8,0,2,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedRule.CurrentFrameIndex}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" MinWidth="15"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 帧列表 -->
                        <ListBox ItemsSource="{Binding EditingFrames}"
                                 SelectedItem="{Binding SelectedEditingFrame}"
                                 ItemContainerStyle="{StaticResource ListItemStyle}"
                                 Background="Transparent" BorderThickness="1"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 MaxHeight="150"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SortOrder, StringFormat=[{0}]}" 
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="2">
                                            <emoji:TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Content}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- 帧编辑 -->
                        <Border Padding="0,6,0,0"
                                Visibility="{Binding SelectedEditingFrame, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="帧名称:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <emojiControls:EmojiTextBox Grid.Column="1"
                                             Text="{Binding SelectedEditingFrame.Name, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                                </Grid>

                                <!-- 响应模式选择 -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="响应模式:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                        <RadioButton Content="纯文本" GroupName="SeqFrameResponseMode"
                                                     IsChecked="{Binding SelectedEditingFrame.ResponseMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=0}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                        <RadioButton Content="协议组帧" GroupName="SeqFrameResponseMode"
                                                     IsChecked="{Binding SelectedEditingFrame.ResponseMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=1}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 纯文本模式：内容 + Hex -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedEditingFrame.ResponseMode}" Value="{x:Static models:ResponseBuildMode.ProtocolBuild}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="内容:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ExpandableTextBoxStyle}"
                                             Text="{Binding SelectedEditingFrame.Content, UpdateSourceTrigger=PropertyChanged}"
                                             pu:TextBoxHelper.Watermark="如: 01 02 03 或 OK"/>
                                    <CheckBox Grid.Column="2" Content="Hex" Margin="8,0,0,0"
                                              IsChecked="{Binding SelectedEditingFrame.IsHexMode}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 协议组帧模式 -->
                                <Border Margin="0,4,0,0" Padding="6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedEditingFrame.ResponseMode}" Value="{x:Static models:ResponseBuildMode.ProtocolBuild}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="协议:" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AvailableProtocols}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Name"
                                                      SelectedValue="{Binding SelectedEditingFrame.ProtocolName, UpdateSourceTrigger=PropertyChanged}"
                                                      Background="{DynamicResource CardBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderBrush}"
                                                      pu:ComboBoxHelper.CornerRadius="4" FontSize="11"/>
                                            <Button Grid.Column="2" Content="⟳ 字段" ToolTip="刷新协议字段" 
                                                    Style="{StaticResource ToolButtonStyle}" Width="Auto" Padding="6,4"
                                                    Command="{Binding RefreshSequentialFrameFieldsCommand}" Margin="4,0,0,0"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SequentialFrameFieldInputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName, StringFormat={}{0}:}" 
                                                                   VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <!-- 普通输入模式 -->
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 pu:TextBoxHelper.Watermark="{Binding Description}"
                                                                 Background="{DynamicResource CardBrush}"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                                 pu:TextBoxHelper.CornerRadius="4"
                                                                 Padding="4,2" FontSize="11">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToggleMode}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <CheckBox Grid.Column="2" Content="Hex" 
                                                                  IsChecked="{Binding IsHexMode}"
                                                                  VerticalAlignment="Center" Margin="4,0,0,0"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToggleMode}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                        <!-- 二元切换模式 -->
                                                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToggleMode}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding ToggleFalseLabel}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsToggleChecked}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ToggleButton IsChecked="{Binding IsToggleChecked}" VerticalAlignment="Center"
                                                                          pu:ToggleButtonHelper.CornerRadius="8" MinWidth="36"/>
                                                            <TextBlock Text="{Binding ToggleTrueLabel}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                       FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsToggleChecked}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- 保存/取消按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="取消" Style="{StaticResource CancelButtonStyle}"
                                Command="{Binding CancelRuleCommand}" Margin="0,0,8,0"/>
                        <Button Content="💾 保存" Style="{StaticResource SaveButtonStyle}"
                                Command="{Binding SaveRuleCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- 状态栏 -->
        <Border Grid.Row="5" Padding="10,6" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="已停止"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Text" Value="运行中"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
