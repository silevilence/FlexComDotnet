<UserControl x:Class="FlexComDotnet.Features.Serial.Views.SerialCommunicationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexComDotnet.Features.Serial.Views"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:models="clr-namespace:FlexComDotnet.Core.Features.Serial.Models;assembly=FlexComDotnet.Core"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource BackgroundBrush}">
    
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ToggleButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="pu:ToggleButtonHelper.CheckedBackground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:ToggleButtonHelper.CheckedForeground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmallToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:TextBoxHelper.CornerRadius" Value="4"/>
            <Setter Property="pu:TextBoxHelper.FocusedShadowColor" Value="{DynamicResource PrimaryColor}"/>
        </Style>
        
        <Style x:Key="TechComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ComboBoxHelper.CornerRadius" Value="4"/>
        </Style>
        
        <Style x:Key="TechCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="pu:CheckBoxHelper.CheckedBackground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:CheckBoxHelper.GlyphBrush" Value="{DynamicResource TextOnPrimaryBrush}"/>
        </Style>

        <!-- ChecksumType 枚举值提供器 -->
        <ObjectDataProvider x:Key="ChecksumTypeValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:ChecksumType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ChecksumType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <converters:ChecksumTypeToDisplayConverter x:Key="ChecksumTypeConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="160"/>
        </Grid.RowDefinitions>
        
        <!-- 接收区 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 接收区标题栏 -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource PanelHeaderBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="接收区" 
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal">
                            <!-- 显示选项 -->
                            <ToggleButton Content="HEX"
                                          IsChecked="{Binding IsHexDisplayMode}"
                                          Style="{StaticResource SmallToggleStyle}"
                                          ToolTip="切换十六进制显示"/>
                            <ToggleButton Content="时间戳"
                                          IsChecked="{Binding ShowTimestamp}"
                                          Style="{StaticResource SmallToggleStyle}"
                                          ToolTip="显示时间戳 (精确到毫秒)"/>
                            <ToggleButton Content="日期"
                                          IsChecked="{Binding ShowDateInTimestamp}"
                                          IsEnabled="{Binding ShowTimestamp}"
                                          Style="{StaticResource SmallToggleStyle}"
                                          ToolTip="时间戳中显示日期"/>
                            <ToggleButton Content="自动换行"
                                          IsChecked="{Binding AutoLineBreak}"
                                          Style="{StaticResource SmallToggleStyle}"
                                          ToolTip="每条数据自动换行"/>
                            
                            <Border Width="1" 
                                    Background="{DynamicResource BorderBrush}" 
                                    Margin="8,4"/>
                            
                            <!-- 控制按钮 -->
                            <ToggleButton IsChecked="{Binding IsPaused}"
                                          ToolTip="暂停/继续屏幕滚动">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource SmallToggleStyle}">
                                        <Setter Property="Content" Value="暂停"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="继续"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Button Content="保存"
                                    Click="SaveLog_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="8,4"
                                    ToolTip="保存通信日志"/>
                            <Button Content="清空"
                                    Command="{Binding ClearReceivedCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- 接收数据显示区 -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource CardBrush}"
                        Padding="0">
                    <ListBox x:Name="ReceivedDataListBox"
                             ItemsSource="{Binding DisplayRecords}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="pack://application:,,,/Fonts/#Maple Mono NF CN"
                             FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制" Click="CopyReceived_Click" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="全选" Click="SelectAllReceived_Click" InputGestureText="Ctrl+A"/>
                                <Separator/>
                                <MenuItem Header="协议解析" Click="ProtocolParse_Click" ToolTip="使用协议解析选中的数据帧"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,2"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <emoji:TextBlock Text="{Binding}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
        
        <!-- 分隔条 -->
        <GridSplitter Grid.Row="1" 
                      Height="6" 
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeNS"/>
        
        <!-- 发送区 -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6"
                Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 发送区标题栏 -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource PanelHeaderBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Path Data="M5,4V6H19V4M5,14H9V20H15V14H19L12,7L5,14Z"
                                  Fill="{DynamicResource AccentBrush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="发送区" 
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal">
                            <ToggleButton Content="HEX"
                                          IsChecked="{Binding IsHexSendMode}"
                                          Style="{StaticResource SmallToggleStyle}"
                                          ToolTip="切换十六进制发送"/>
                            <Button Content="协议组帧"
                                    Click="ProtocolBuild_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="8,4"
                                    ToolTip="打开协议组帧窗口"/>
                            <Button Content="清空"
                                    Command="{Binding ClearSendCommand}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- 发送文本框 -->
                <TextBox Grid.Row="1"
                         Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="pack://application:,,,/Fonts/#Maple Mono NF CN"
                         FontSize="12"
                         Padding="12"
                         BorderThickness="0"
                         Background="{DynamicResource CardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource PrimaryBrush}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" 
                                    Modifiers="Ctrl" 
                                    Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                
                <!-- 发送选项栏 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <!-- 追加选项 -->
                        <CheckBox Content="追加 CR LF"
                                  IsChecked="{Binding AppendCrLf}"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TechCheckBoxStyle}"
                                  ToolTip="发送时自动追加回车换行符"/>
                        
                        <Border Width="1" 
                                Background="{DynamicResource BorderBrush}" 
                                Margin="12,4"/>
                        
                        <!-- 校验和选项 -->
                        <TextBlock Text="校验和:" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource ChecksumTypeValues}}"
                                  SelectedItem="{Binding AppendChecksumType}"
                                  Width="120"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TechComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ChecksumTypeConverter}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Width="1" 
                                Background="{DynamicResource BorderBrush}" 
                                Margin="12,4"/>

                        <!-- 定时发送 -->
                        <ToggleButton IsChecked="{Binding IsTimerEnabled, Mode=TwoWay}"
                                      ToolTip="启用/停止定时循环发送">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource SmallToggleStyle}">
                                    <Setter Property="Content" Value="定时发送"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="停止"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <TextBox Text="{Binding TimerInterval, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60"
                                 Height="26"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Margin="4,0,0,0"
                                 Style="{StaticResource TechTextBoxStyle}"
                                 ToolTip="发送间隔 (毫秒)"/>
                        <TextBlock Text="ms" 
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource StatusLabelStyle}"/>
                    </StackPanel>
                </Border>
                
                <!-- 发送按钮区 -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,6,6"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 发送状态 -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SendStatus}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        
                        <!-- 发送按钮 -->
                        <Button Grid.Column="1"
                                Command="{Binding SendCommand}"
                                pu:ButtonHelper.CornerRadius="6"
                                Padding="20,10"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                                      Fill="{DynamicResource TextOnPrimaryBrush}"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="发送 (Ctrl+Enter)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
