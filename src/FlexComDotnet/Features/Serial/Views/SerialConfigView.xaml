<UserControl x:Class="FlexComDotnet.Features.Serial.Views.SerialConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexComDotnet.Features.Serial.Views"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="280"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    
    <UserControl.Resources>
        <converters:BaudRateDisplayConverter x:Key="BaudRateDisplayConverter"/>
        <converters:DataBitsDisplayConverter x:Key="DataBitsDisplayConverter"/>
        <converters:StopBitsDisplayConverter x:Key="StopBitsDisplayConverter"/>
        <converters:ParityDisplayConverter x:Key="ParityDisplayConverter"/>
        <converters:FlowControlDisplayConverter x:Key="FlowControlDisplayConverter"/>
        
        <Style x:Key="ConfigLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="ConfigComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <Border Padding="12" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 标题 -->
            <TextBlock Grid.Row="0" 
                       Text="串口配置" 
                       FontSize="16" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>
            
            <!-- 串口选择 -->
            <Grid Grid.Row="1" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsConfigEnabled}"
                          Style="{StaticResource ConfigComboBoxStyle}"/>
                
                <Button Grid.Column="1"
                        Content="🔄"
                        Width="28"
                        Height="28"
                        Margin="4,4,0,4"
                        ToolTip="刷新串口列表"
                        Command="{Binding RefreshPortsCommand}"
                        IsEnabled="{Binding IsConfigEnabled}"/>
            </Grid>
            
            <!-- 波特率 -->
            <Grid Grid.Row="2" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="波特率" Style="{StaticResource ConfigLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableBaudRates}"
                          SelectedItem="{Binding SelectedBaudRate}"
                          IsEnabled="{Binding IsConfigEnabled}"
                          Style="{StaticResource ConfigComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource BaudRateDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            
            <!-- 数据位 -->
            <Grid Grid.Row="3" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="数据位" Style="{StaticResource ConfigLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableDataBits}"
                          SelectedItem="{Binding SelectedDataBits}"
                          IsEnabled="{Binding IsConfigEnabled}"
                          Style="{StaticResource ConfigComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DataBitsDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            
            <!-- 停止位 -->
            <Grid Grid.Row="4" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="停止位" Style="{StaticResource ConfigLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableStopBits}"
                          SelectedItem="{Binding SelectedStopBits}"
                          IsEnabled="{Binding IsConfigEnabled}"
                          Style="{StaticResource ConfigComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource StopBitsDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            
            <!-- 校验位 -->
            <Grid Grid.Row="5" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="校验位" Style="{StaticResource ConfigLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableParities}"
                          SelectedItem="{Binding SelectedParity}"
                          IsEnabled="{Binding IsConfigEnabled}"
                          Style="{StaticResource ConfigComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ParityDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            
            <!-- 流控 -->
            <Grid Grid.Row="6" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="流控" Style="{StaticResource ConfigLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableFlowControls}"
                          SelectedItem="{Binding SelectedFlowControl}"
                          IsEnabled="{Binding IsConfigEnabled}"
                          Style="{StaticResource ConfigComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FlowControlDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            
            <!-- 连接按钮 -->
            <Button Grid.Row="7"
                    Content="{Binding ConnectionButtonText}"
                    Height="36"
                    Margin="0,16,0,8"
                    FontSize="14"
                    Command="{Binding ToggleConnectionCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#0078D4"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Background" Value="#D83B01"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <!-- 状态信息 -->
            <Border Grid.Row="8" 
                    Background="#F5F5F5" 
                    CornerRadius="4" 
                    Padding="8"
                    VerticalAlignment="Top"
                    Margin="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 连接状态指示灯 -->
                    <Ellipse Grid.Column="0"
                             Width="10"
                             Height="10"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#888888"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#107C10"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
