<UserControl x:Class="FlexComDotnet.Features.Serial.Views.CommandListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexComDotnet.Features.Serial.Views"
             xmlns:converters="clr-namespace:FlexComDotnet.Converters"
             xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300"
             Background="{DynamicResource SurfaceBrush}">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="pu:ButtonHelper.CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="TechCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="pu:CheckBoxHelper.CheckedBackground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:CheckBoxHelper.GlyphBrush" Value="{DynamicResource TextOnPrimaryBrush}"/>
        </Style>
        
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="pu:TextBoxHelper.CornerRadius" Value="4"/>
            <Setter Property="pu:TextBoxHelper.FocusedShadowColor" Value="{DynamicResource PrimaryColor}"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V7H9V15H11V10H13V15H15V12H17V17Z"
                          Fill="{DynamicResource PrimaryBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="指令列表" 
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding AddCommandCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="添加指令">
                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </Button>
                    <Button Command="{Binding EditCommandCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="编辑选中指令"
                            IsEnabled="{Binding SelectedCommand, Converter={StaticResource NullToBoolConverter}}">
                        <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </Button>
                    <Button Command="{Binding DeleteCommandCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="删除选中指令">
                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 指令列表 -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Commands}"
                 SelectedItem="{Binding SelectedCommand}"
                 BorderThickness="0"
                 Background="{DynamicResource SurfaceBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource ListItemStyle}"
                 x:Name="CommandListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 启用/禁用复选框 -->
                        <CheckBox Grid.Column="0" Grid.RowSpan="2"
                                  IsChecked="{Binding IsEnabled}"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TechCheckBoxStyle}"
                                  Margin="0,0,10,0"/>
                        
                        <!-- 名称 -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        
                        <!-- 内容预览 -->
                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Content}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontFamily="Cascadia Code, Consolas"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="150"/>
                            <Border Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="2"
                                    Padding="4,1"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding IsHexMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="HEX"
                                           Foreground="{DynamicResource TextOnPrimaryBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        
                        <!-- 发送按钮 -->
                        <Button Grid.Column="2" Grid.RowSpan="2"
                                Content="发送"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="SendButton_Click"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- 排序按钮 -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding MoveUpCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Margin="0,0,4,0"/>
                        <TextBlock Text="上移"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MoveDownCommand}"
                        Style="{StaticResource ActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Margin="0,0,4,0"/>
                        <TextBlock Text="下移"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- 状态栏 -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Text="{Binding SendStatus}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
        
        <!-- 编辑面板 (覆盖层) -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource SurfaceBrush}"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 面板标题 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                          Fill="{DynamicResource PrimaryBrush}"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding EditPanelTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                
                <!-- 名称 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="名称:" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TechTextBoxStyle}"
                             Padding="8,6"/>
                </Grid>
                
                <!-- 内容 -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="内容:" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TechTextBoxStyle}"
                             Padding="8,6"
                             FontFamily="Cascadia Code, Consolas"/>
                </Grid>
                
                <!-- 描述 -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="描述:" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TechTextBoxStyle}"
                             Padding="8,6"/>
                </Grid>
                
                <!-- Hex 模式 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="1"
                              Content="HEX 模式"
                              IsChecked="{Binding EditIsHexMode}"
                              Style="{StaticResource TechCheckBoxStyle}"/>
                </Grid>
                
                <!-- 按钮 -->
                <StackPanel Grid.Row="6" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="取消"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="80"/>
                    <Button Content="保存"
                            Command="{Binding SaveEditCommand}"
                            Width="80"
                            Margin="8,0,0,0"
                            pu:ButtonHelper.CornerRadius="4"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource TextOnPrimaryBrush}"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
