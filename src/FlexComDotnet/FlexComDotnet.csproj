<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FlexComDotnet.Core\FlexComDotnet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Panuon.WPF.UI" Version="1.3.0.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.6.0</Version>
    <SerialMonitorDriverProjectDirectory>$(MSBuildProjectDirectory)\..\..\driver\serial-monitor</SerialMonitorDriverProjectDirectory>
    <SerialMonitorDriverCargoProfile>debug</SerialMonitorDriverCargoProfile>
    <SerialMonitorDriverBuildCommand>powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(SerialMonitorDriverProjectDirectory)\scripts\Package-DebugDriver.ps1&quot;</SerialMonitorDriverBuildCommand>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SerialMonitorDriverCargoProfile>release</SerialMonitorDriverCargoProfile>
    <SerialMonitorDriverBuildCommand>powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(SerialMonitorDriverProjectDirectory)\scripts\Package-DebugDriver.ps1&quot; -Profile release</SerialMonitorDriverBuildCommand>
  </PropertyGroup>

  <PropertyGroup>
    <SerialMonitorDriverPackageDirectory>$(SerialMonitorDriverProjectDirectory)\target\$(SerialMonitorDriverCargoProfile)\serial_monitor_package</SerialMonitorDriverPackageDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features\Scripting\Resources\LuaSyntax.xshd" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\MapleMono-NF-CN-Regular.ttf" />
  </ItemGroup>

  <Target Name="BuildSerialMonitorDriver"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildSerialMonitorDriver)' != 'false'">
    <Exec WorkingDirectory="$(SerialMonitorDriverProjectDirectory)"
          Command="$(SerialMonitorDriverBuildCommand)"
          IgnoreStandardErrorWarningFormat="true" />

    <Error Condition="!Exists('$(SerialMonitorDriverPackageDirectory)\serial_monitor.sys')"
           Text="Rust 驱动构建未生成 serial_monitor.sys：$(SerialMonitorDriverPackageDirectory)" />
    <Error Condition="!Exists('$(SerialMonitorDriverPackageDirectory)\serial_monitor.inf')"
           Text="Rust 驱动构建未生成 serial_monitor.inf：$(SerialMonitorDriverPackageDirectory)" />

    <ItemGroup>
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\serial_monitor.sys" />
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\serial_monitor.inf" />
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\serial_monitor.cat"
                                   Condition="Exists('$(SerialMonitorDriverPackageDirectory)\serial_monitor.cat')" />
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\WDRLocalTestCert.cer"
                                   Condition="Exists('$(SerialMonitorDriverPackageDirectory)\WDRLocalTestCert.cer')" />
    </ItemGroup>

    <Copy SourceFiles="@(_SerialMonitorDriverPackage)"
          DestinationFolder="$(OutDir)driver\serial-monitor\"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySerialMonitorDriverToPublishDirectory"
          AfterTargets="Publish"
          DependsOnTargets="BuildSerialMonitorDriver"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildSerialMonitorDriver)' != 'false'">
    <ItemGroup>
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\serial_monitor.sys" />
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\serial_monitor.inf" />
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\serial_monitor.cat"
                                   Condition="Exists('$(SerialMonitorDriverPackageDirectory)\serial_monitor.cat')" />
      <_SerialMonitorDriverPackage Include="$(SerialMonitorDriverPackageDirectory)\WDRLocalTestCert.cer"
                                   Condition="Exists('$(SerialMonitorDriverPackageDirectory)\WDRLocalTestCert.cer')" />
    </ItemGroup>

    <Copy SourceFiles="@(_SerialMonitorDriverPackage)"
          DestinationFolder="$(PublishDir)driver\serial-monitor\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
